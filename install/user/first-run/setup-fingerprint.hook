#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if oal-hw-fingerprint && [[ ! -f /etc/pam.d/oal-lock-fingerprint ]] &&
  oal-done ensure fingerprint-setup-invitation; then
  oal-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec "oal-launch-floating-terminal-with-presentation oal-setup-security-fingerprint"
fi
