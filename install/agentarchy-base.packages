# Agentarchy base packages -- the headless layer: CLI, services, no GUI.
#
# Native to Agentarchy, not vendored: upstream's lists name a Hyprland/Quickshell desktop and carry
# AUR-only and nonexistent packages. Everything here is in core/extra, so a default install never
# needs the AUR (see install/agentarchy-aur.packages for the opt-in extras).
#
# Format: one package per line, '#' comments and blank lines ignored. Consumed by
#   sed -e 's/#.*//' -e '/^[[:space:]]*$/d' <list> | pacman -S --needed --noconfirm -
# Every line is verified against the archlinux.org JSON API by test/unit/packages.bats.

# --- toolchain and shell basics
base-devel
git
pacman-contrib
jq
gum
bash-completion
openssh
sudo
man-db
less
wget
curl
unzip

# --- networking and services
networkmanager
tailscale
syncthing

# --- audio (the desktop list adds the KDE front-ends)
pipewire
pipewire-pulse
wireplumber

# --- hardware
bluez
bluez-utils
bluez-tools
power-profiles-daemon
# Printing. cups plus avahi is the whole discovery stack a modern network printer needs: CUPS
# does driverless IPP Everywhere over mDNS itself.
#
# cups-browsed is deliberately NOT here. It is the legacy CUPS-broadcast bridge, it listens on
# UDP 631 for unauthenticated printer announcements, and it is the daemon at the centre of the
# 2024 CUPS remote-execution chain (CVE-2024-47076 / 47175 / 47176 / 47177). The inbound port is
# closed by install/config/firewall.sh either way, so this is not a hole being patched -- it is a
# daemon that was buying discovery we already have.
cups
avahi

# --- filesystem and boot
btrfs-progs
# install/config/locate.sh tunes locate's prune rules and install/post-install/localdb.sh runs
# updatedb, so the locate implementation has to be installed.
plocate
snapper
plymouth

# --- security
ufw
age

# --- terminal tooling
# nano before anything clever: $EDITOR has to name something that exists. There was no terminal
# editor in either list at all, so `git commit` with no -m, `sudoedit`, `systemctl edit` and
# `crontab -e` all failed, and `visudo` fell back to a vi that was not installed either.
nano
ripgrep
fd
bat
eza
fzf
zoxide
starship
tmux
lazygit
lazydocker
htop
btop

# --- containers
docker
docker-compose

# --- language runtimes the vendored scripts already assume
github-cli
nodejs
npm
python
uv
rustup
go

# --- fonts (ttf-ia-writer is AUR-only and lives in the AUR list)
noto-fonts
noto-fonts-emoji
noto-fonts-cjk
ttf-jetbrains-mono-nerd
