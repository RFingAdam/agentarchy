# Paths (globs relative to upstream root) vendored by bin/oal-dev-sync-upstream.
# Later lines win. Everything not included is ignored.

include bin/omarchy-*
include bin/omarchy
include install/**
include default/**
include config/**
include themes/**
include applications/**
include agents/**
include etc/**

# --- never vendor: compositor/shell-bound, docs, branding, tests, upstream migrations
exclude bin/omarchy-dev-*
exclude shell/**
exclude config/hypr/**
exclude config/hyprland-preview-share-picker/**
exclude config/omarchy/shell.json
exclude default/hypr/**
exclude default/uwsm/**
exclude default/wayland-sessions/**
exclude default/xdg-terminal-exec/**
exclude default/libalpm/hooks/*hyprland*
exclude default/fonts/**
exclude default/voxtype/**
exclude default/themed/hyprland.lua.tpl
exclude default/themed/hyprland-preview-share-picker.css.tpl
exclude default/themed/shell.toml.tpl
exclude themes/*/shell.lock.toml
exclude default/sddm/*/logo.png
exclude default/sddm/hyprland.lua
# The greeter itself is Agentarchy's now, and its five sprites are gone. Upstream draws the lock,
# the entry field and the password dots as PNGs in one hard-coded colour (#C0CAF5, tokyo-night's
# bright_foreground), which cannot follow a palette: on the five light themes it would be light on
# light. They are also unaccounted assets of exactly the class docs/asset-audit-findings.md rules
# on -- vendored bytes, no licence, absent from NOTICE, and outside that audit's wallpaper scope --
# so they are dropped rather than re-published. Main.qml is excluded with them because it exists to
# place them; ours draws the same greeter from theme.conf, rendered per theme from the palette.
# Globs here match upstream paths, before RENAME-PATHS.sed turns the directory into sddm/oal --
# hence the wildcard, same as the logo.png line above.
exclude default/sddm/*/Main.qml
exclude default/sddm/*/lock.png
exclude default/sddm/*/lock-failed.png
exclude default/sddm/*/entry.png
exclude default/sddm/*/entry-failed.png
exclude default/sddm/*/bullet.png
# The greeter drop-in exists only to point SDDM's Wayland greeter at that hyprland.lua. Agentarchy
# decided the other way in install/desktop/plasma.sh: the greeter stays on SDDM's X11 default (the
# Wayland greeter is experimental upstream) and autologin skips it entirely. Vendoring a config that
# names a compositor we never ship would leave a file that breaks login the moment anyone installs
# it, so drop it rather than port it. 10-theme.conf stays: Current=oal is still what we want once
# oal-refresh-sddm has installed the theme.
exclude etc/sddm.conf.d/10-wayland.conf
# Agent skill for developing the Quickshell desktop under shell/, which we never vendor. It is
# the one vendored file that keeps a literal 'omarchy' (the shell-injected QML property
# omarchyPath); renaming that would invent an upstream API name, so drop the file instead.
exclude agents/skills/shell-dev.md
# icon-font.md targets default/fonts/oal/oal.ttf (default/fonts/** excluded above);
# acceptance-tests.md targets test/acceptance.d/, which is not vendored at all.
exclude agents/skills/icon-font.md
exclude agents/skills/acceptance-tests.md

# --- symlinks are never vendored in Phase 0 (the sync refuses them); this one points at the
# upstream root icon.png (branding, itself never vendored)
exclude default/chromium/extensions/copy-url/icon.png

# --- upstream branding / compositor screenshots -- never vendored; Phase 2 regenerates previews.
# Gates are text-based and cannot see inside an image, so every "never vendor branding" rule has to
# live here as a path exclude. themes/*/unlock.png is the upstream wordmark in each theme's colours
# (checked 2026-08-23: gruvbox spells it out, tokyo-night/vantablack/white are the logo mark), and
# default/plymouth/preview-unlock.png is a screenshot of the boot splash showing that wordmark.
# --- wallpapers are no longer vendored at all (2026-08-23).
# docs/asset-audit-findings.md: upstream solicited these images in issue #617 with rules about
# resolution, file size and taste, and never asked contributors where they came from. Not one of the
# 68 carries a licence, two point at where they were copied from, and one still has stock-library
# EXIF. A fork that re-publishes them under a different name cannot inherit rights upstream never
# established, so the whole class is excluded rather than audited file by file. Each theme ships a
# wallpaper generated from its own palette instead (bin/oal-dev-make-wallpapers).
exclude themes/*/backgrounds/**
exclude themes/*/preview.png
exclude themes/*/preview-unlock.png
exclude themes/*/unlock.png
exclude default/plymouth/logo.png
exclude default/plymouth/logos/**
exclude default/plymouth/preview-unlock.png
exclude **/logo.*
exclude **/icon.*
exclude **/logos/**
exclude themes/*/hyprland.lua
# Superseded by default/themed/starship.toml.tpl, which renders per theme and is what
# STARSHIP_CONFIG points at. Delivered to ~/.config it would be read by nothing while looking like
# the file to edit, which is worse than not shipping it.
exclude config/starship.toml
# --- three themes dropped 2026-08-23, on the "what will nobody use" question.
# Agentarchy ships its own palette as the default now (themes/agentarchy, native), and the light
# ones were the least defensible of the inherited set. lupine and flexoki-light are niche. rose-pine
# is the interesting one: what upstream ships under that name is Rosé Pine *Dawn*, the light variant,
# while the flagship of that family is dark, so the name promised the wrong thing. themes/rose-pine
# is native now and carries the dark original -- the exclude keeps upstream's Dawn out so ours is not
# overwritten by a sync. The green and the blue it needed are designed rather than ported, and the
# file says which and why.
exclude themes/lupine/**
exclude themes/flexoki-light/**
exclude themes/rose-pine/**
# Three more wallpapers carry the wordmark or the logo mark but were never named after the upstream
# project, so no name-based rule could reach them. Caught by looking at the pixels (runbook step (a)
# in upstream/README.md), which is the only thing that can find this class of file. Listed as path
# literals because there is no pattern here to generalise.

# --- distro-defining files: these are Agentarchy's decisions, not upstream's.
# The package lists name a different desktop (KDE Plasma, not Hyprland/Quickshell) and upstream's
# carry 22 AUR-only and ~21 nonexistent packages; default/pacman/* points every repo at
# *.agentarchy.invalid stubs, and install/post-install/pacman.sh copies those stubs over
# /etc/pacman.conf and the mirrorlist, which ends any install with a dead pacman. Native
# replacements live in install/agentarchy-{base,desktop,aur}.packages.
exclude install/omarchy-base.packages
exclude install/omarchy-other.packages
exclude default/pacman/**
exclude install/post-install/pacman.sh
