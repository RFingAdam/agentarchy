# Paths (globs relative to upstream root) vendored by bin/oal-dev-sync-upstream.
# Later lines win. Everything not included is ignored.

include bin/omarchy-*
include bin/omarchy
include install/**
include default/**
include config/**
include themes/**
include applications/**
include agents/**
include etc/**

# --- never vendor: compositor/shell-bound, docs, branding, tests, upstream migrations
exclude bin/omarchy-dev-*
exclude shell/**
exclude config/hypr/**
exclude config/hyprland-preview-share-picker/**
exclude config/omarchy/shell.json
exclude default/hypr/**
exclude default/uwsm/**
exclude default/wayland-sessions/**
exclude default/xdg-terminal-exec/**
exclude default/libalpm/hooks/*hyprland*
exclude default/fonts/**
exclude default/voxtype/**
exclude default/themed/hyprland.lua.tpl
exclude default/themed/hyprland-preview-share-picker.css.tpl
exclude default/themed/shell.toml.tpl
exclude themes/*/shell.lock.toml
exclude default/sddm/*/logo.png
exclude default/sddm/hyprland.lua
# Agent skill for developing the Quickshell desktop under shell/, which we never vendor. It is
# the one vendored file that keeps a literal 'omarchy' (the shell-injected QML property
# omarchyPath); renaming that would invent an upstream API name, so drop the file instead.
exclude agents/skills/shell-dev.md
# icon-font.md targets default/fonts/oal/oal.ttf (default/fonts/** excluded above);
# acceptance-tests.md targets test/acceptance.d/, which is not vendored at all.
exclude agents/skills/icon-font.md
exclude agents/skills/acceptance-tests.md

# --- symlinks are never vendored in Phase 0 (the sync refuses them); this one points at the
# upstream root icon.png (branding, itself never vendored)
exclude default/chromium/extensions/copy-url/icon.png

# --- upstream branding / compositor screenshots — never vendored; Phase 2 regenerates previews.
# Gates are text-based and cannot see inside an image, so every "never vendor branding" rule has to
# live here as a path exclude. themes/*/unlock.png is the upstream wordmark in each theme's colours
# (checked 2026-08-23: gruvbox spells it out, tokyo-night/vantablack/white are the logo mark), and
# default/plymouth/preview-unlock.png is a screenshot of the boot splash showing that wordmark.
exclude themes/*/backgrounds/*omarchy*
exclude themes/*/preview.png
exclude themes/*/preview-unlock.png
exclude themes/*/unlock.png
exclude default/plymouth/logo.png
exclude default/plymouth/logos/**
exclude default/plymouth/preview-unlock.png
exclude **/logo.*
exclude **/icon.*
exclude **/logos/**
exclude themes/*/hyprland.lua
# Three more wallpapers carry the wordmark or the logo mark but were never named after the upstream
# project, so no name-based rule could reach them. Caught by looking at the pixels (runbook step (a)
# in upstream/README.md), which is the only thing that can find this class of file. Listed as path
# literals because there is no pattern here to generalise.
exclude themes/lumon/backgrounds/02-opinions-equally.webp
exclude themes/tokyo-night/backgrounds/5-oma-cityscape.jpg
exclude themes/tokyo-night/backgrounds/6-oma.webp

# --- distro-defining files: these are Agentarchy's decisions, not upstream's.
# The package lists name a different desktop (KDE Plasma, not Hyprland/Quickshell) and upstream's
# carry 22 AUR-only and ~21 nonexistent packages; default/pacman/* points every repo at
# *.agentarchy.invalid stubs, and install/post-install/pacman.sh copies those stubs over
# /etc/pacman.conf and the mirrorlist, which ends any install with a dead pacman. Native
# replacements live in install/agentarchy-{base,desktop,aur}.packages.
exclude install/omarchy-base.packages
exclude install/omarchy-other.packages
exclude default/pacman/**
exclude install/post-install/pacman.sh
