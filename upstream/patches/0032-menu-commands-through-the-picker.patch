--- a/bin/oal-menu-input
+++ b/bin/oal-menu-input
@@ -29,30 +29,25 @@
   shift
 done
 
-selection_file=$(mktemp)
-done_file=$(mktemp)
-rm -f "$done_file"
-trap 'rm -f "$selection_file" "$done_file"' EXIT
