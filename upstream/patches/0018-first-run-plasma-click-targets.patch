--- a/install/user/first-run/setup-agent.hook
+++ b/install/user/first-run/setup-agent.hook
@@ -4,8 +4,14 @@
 
 # Agentarchy ships no default agent, so invite once rather than picking one. An
 # agent already chosen means the invitation has nothing to offer.
-if [[ -z $(oal-default-agent) ]] && oal-done ensure agent-setup-invitation; then
-  oal-notification-send -u critical -g 󰚩 "Set your default agent" \
-    "Let your favorite agent help with Agentarchy." \
-    --exec "oal menu summon setup.default.agent"
+#
+# oal-brain-backend, not upstream's oal-default-agent, which was excluded from
+# vendoring and does not exist here: the substitution came back empty either
+# way, so the invitation fired whether or not an agent had been chosen. The
+# click target was upstream's Quickshell menu route, which this tree has no
+# implementation of at all.
+if [[ -z $(oal-brain-backend 2>/dev/null) ]] && oal-done ensure agent-setup-invitation; then
+  oal-notification-send -u critical -g 󰚩 "Choose an agent" \
+    "Pick which agent this machine talks to." \
+    --exec "oal-menu agent"
 fi
--- a/install/user/first-run/welcome.sh
+++ b/install/user/first-run/welcome.sh
@@ -1,5 +1,10 @@
+# The shortcuts this desktop actually binds, and a click target it actually has.
+# Upstream's cheatsheet and its oal-menu-keybindings viewer are both Quickshell
+# surfaces that were never vendored, so the old card advertised a key that does
+# nothing and opened a command that does not exist.
+#
 # Real newlines, not a literal \n: the card renders the body as it arrives, and
 # elides past three lines.
-oal-notification-send -u critical -g  "Learn Keybindings" \
-  $'Super + K for cheatsheet.\nSuper + Space for Agentarchy Menu.' \
-  --exec oal-menu-keybindings
+oal-notification-send -u critical -g  "Two keys worth knowing" \
+  $'Super + Space opens the Agentarchy menu.\nSuper + A asks this machine a question.' \
+  --exec oal-menu
--- a/install/user/first-run/wifi.sh
