# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=40,40,40

[BackgroundIntense]
Color=30,30,30

[Foreground]
Color=212,190,152

[ForegroundIntense]
Color=212,190,152

[Color0]
Color=40,40,40

[Color0Intense]
Color=102,92,84

[Color1]
Color=234,105,98

[Color1Intense]
Color=234,105,98

[Color2]
Color=169,182,101

[Color2Intense]
Color=169,182,101

[Color3]
Color=216,166,87

[Color3Intense]
Color=216,166,87

[Color4]
Color=125,174,163

[Color4Intense]
Color=125,174,163

[Color5]
Color=211,134,155

[Color5Intense]
Color=211,134,155

[Color6]
Color=137,180,130

[Color6Intense]
Color=137,180,130

[Color7]
Color=212,190,152

[Color7Intense]
Color=212,190,152

[General]
Blur=false
ColorRandomization=false
Description=OAL Gruvbox
Opacity=1
Wallpaper=
