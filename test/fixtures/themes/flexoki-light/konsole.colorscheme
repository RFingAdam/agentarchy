# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=255,252,240

[BackgroundIntense]
Color=242,239,228

[Foreground]
Color=16,15,15

[ForegroundIntense]
Color=16,15,15

[Color0]
Color=255,252,240

[Color0Intense]
Color=183,181,172

[Color1]
Color=209,77,65

[Color1Intense]
Color=209,77,65

[Color2]
Color=135,154,57

[Color2Intense]
Color=135,154,57

[Color3]
Color=208,162,21

[Color3Intense]
Color=208,162,21

[Color4]
Color=32,94,166

[Color4Intense]
Color=67,133,190

[Color5]
Color=206,93,151

[Color5Intense]
Color=206,93,151

[Color6]
Color=58,169,159

[Color6Intense]
Color=58,169,159

[Color7]
Color=16,15,15

[Color7Intense]
Color=16,15,15

[General]
Blur=false
ColorRandomization=false
Description=OAL Flexoki Light
Opacity=1
Wallpaper=
