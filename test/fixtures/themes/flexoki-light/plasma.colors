ForegroundNormal=16,15,15
ForegroundInactive=183,181,172
ForegroundActive=32,94,166
ForegroundLink=32,94,166
ForegroundVisited=206,93,151
ForegroundNegative=209,77,65
ForegroundNeutral=208,162,21
ForegroundPositive=135,154,57

