# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=17,28,24

[BackgroundIntense]
Color=12,21,18

[Foreground]
Color=193,196,151

[ForegroundIntense]
Color=247,232,178

[Color0]
Color=17,28,24

[Color0Intense]
Color=83,104,91

[Color1]
Color=255,83,69

[Color1Intense]
Color=219,159,156

[Color2]
Color=84,158,106

[Color2Intense]
Color=99,176,122

[Color3]
Color=69,148,81

[Color3Intense]
Color=229,199,54

[Color4]
Color=80,148,117

[Color4Intense]
Color=172,212,207

[Color5]
Color=210,104,156

[Color5Intense]
Color=117,187,179

[Color6]
Color=45,213,183

[Color6Intense]
Color=140,211,203

[Color7]
Color=193,196,151

[Color7Intense]
Color=247,232,178

[General]
Blur=false
ColorRandomization=false
Description=OAL Osaka Jade
Opacity=1
Wallpaper=
