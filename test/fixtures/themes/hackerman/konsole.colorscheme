# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=11,12,22

[BackgroundIntense]
Color=8,9,16

[Foreground]
Color=221,247,255

[ForegroundIntense]
Color=221,247,255

[Color0]
Color=11,12,22

[Color0Intense]
Color=45,52,80

[Color1]
Color=80,248,114

[Color1Intense]
Color=133,255,157

[Color2]
Color=79,232,143

[Color2Intense]
Color=156,247,194

[Color3]
Color=80,247,212

[Color3Intense]
Color=164,255,236

[Color4]
Color=130,157,212

[Color4Intense]
Color=196,210,237

[Color5]
Color=134,167,223

[Color5Intense]
Color=205,219,244

[Color6]
Color=124,248,247

[Color6Intense]
Color=209,255,254

[Color7]
Color=221,247,255

[Color7Intense]
Color=221,247,255

[General]
Blur=false
ColorRandomization=false
Description=OAL Hackerman
Opacity=1
Wallpaper=
