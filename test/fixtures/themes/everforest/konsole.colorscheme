# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=45,53,59

[BackgroundIntense]
Color=33,39,44

[Foreground]
Color=211,198,170

[ForegroundIntense]
Color=211,198,170

[Color0]
Color=45,53,59

[Color0Intense]
Color=71,82,88

[Color1]
Color=230,126,128

[Color1Intense]
Color=230,126,128

[Color2]
Color=167,192,128

[Color2Intense]
Color=167,192,128

[Color3]
Color=219,188,127

[Color3Intense]
Color=219,188,127

[Color4]
Color=127,187,179

[Color4Intense]
Color=127,187,179

[Color5]
Color=214,153,182

[Color5Intense]
Color=214,153,182

[Color6]
Color=131,192,146

[Color6Intense]
Color=131,192,146

[Color7]
Color=211,198,170

[Color7Intense]
Color=211,198,170

[General]
Blur=false
ColorRandomization=false
Description=OAL Everforest
Opacity=1
Wallpaper=
