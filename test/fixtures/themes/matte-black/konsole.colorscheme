# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=18,18,18

[BackgroundIntense]
Color=13,13,13

[Foreground]
Color=190,190,190

[ForegroundIntense]
Color=190,190,190

[Color0]
Color=18,18,18

[Color0Intense]
Color=51,51,51

[Color1]
Color=211,95,95

[Color1Intense]
Color=185,28,28

[Color2]
Color=255,193,7

[Color2Intense]
Color=255,193,7

[Color3]
Color=185,28,28

[Color3Intense]
Color=185,10,10

[Color4]
Color=230,142,13

[Color4Intense]
Color=245,158,11

[Color5]
Color=211,95,95

[Color5Intense]
Color=185,28,28

[Color6]
Color=190,190,190

[Color6Intense]
Color=234,234,234

[Color7]
Color=190,190,190

[Color7Intense]
Color=190,190,190

[General]
Blur=false
ColorRandomization=false
Description=OAL Matte Black
Opacity=1
Wallpaper=
