# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=255,255,255

[BackgroundIntense]
Color=245,245,245

[Foreground]
Color=0,0,0

[ForegroundIntense]
Color=0,0,0

[Color0]
Color=255,255,255

[Color0Intense]
Color=128,128,128

[Color1]
Color=42,42,42

[Color1Intense]
Color=42,42,42

[Color2]
Color=58,58,58

[Color2Intense]
Color=58,58,58

[Color3]
Color=74,74,74

[Color3Intense]
Color=74,74,74

[Color4]
Color=26,26,26

[Color4Intense]
Color=26,26,26

[Color5]
Color=46,46,46

[Color5Intense]
Color=46,46,46

[Color6]
Color=62,62,62

[Color6Intense]
Color=62,62,62

[Color7]
Color=0,0,0

[Color7Intense]
Color=0,0,0

[General]
Blur=false
ColorRandomization=false
Description=OAL White
Opacity=1
Wallpaper=
