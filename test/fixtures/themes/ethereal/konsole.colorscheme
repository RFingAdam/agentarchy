# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=6,11,30

[BackgroundIntense]
Color=4,8,22

[Foreground]
Color=255,206,173

[ForegroundIntense]
Color=255,206,173

[Color0]
Color=6,11,30

[Color0Intense]
Color=109,125,182

[Color1]
Color=237,91,90

[Color1Intense]
Color=250,170,169

[Color2]
Color=146,165,147

[Color2Intense]
Color=196,207,196

[Color3]
Color=233,187,79

[Color3Intense]
Color=247,220,156

[Color4]
Color=125,130,217

[Color4Intense]
Color=194,196,240

[Color5]
Color=200,157,193

[Color5Intense]
Color=234,215,231

[Color6]
Color=163,191,209

[Color6Intense]
Color=223,234,240

[Color7]
Color=255,206,173

[Color7Intense]
Color=255,206,173

[General]
Blur=false
ColorRandomization=false
Description=OAL Ethereal
Opacity=1
Wallpaper=
