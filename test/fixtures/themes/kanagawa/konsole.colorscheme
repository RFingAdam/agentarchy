# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=31,31,40

[BackgroundIntense]
Color=23,23,30

[Foreground]
Color=220,215,186

[ForegroundIntense]
Color=220,215,186

[Color0]
Color=31,31,40

[Color0Intense]
Color=84,84,109

[Color1]
Color=195,64,67

[Color1Intense]
Color=232,36,36

[Color2]
Color=118,148,106

[Color2Intense]
Color=152,187,108

[Color3]
Color=192,163,110

[Color3Intense]
Color=230,195,132

[Color4]
Color=126,156,216

[Color4Intense]
Color=127,180,202

[Color5]
Color=149,127,184

[Color5Intense]
Color=147,138,169

[Color6]
Color=106,149,137

[Color6Intense]
Color=122,168,159

[Color7]
Color=220,215,186

[Color7Intense]
Color=220,215,186

[General]
Blur=false
ColorRandomization=false
Description=OAL Kanagawa
Opacity=1
Wallpaper=
