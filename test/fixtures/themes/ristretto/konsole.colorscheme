# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=44,37,37

[BackgroundIntense]
Color=33,27,27

[Foreground]
Color=230,217,219

[ForegroundIntense]
Color=230,217,219

[Color0]
Color=44,37,37

[Color0Intense]
Color=114,105,106

[Color1]
Color=253,104,131

[Color1Intense]
Color=255,130,151

[Color2]
Color=173,218,120

[Color2Intense]
Color=200,226,146

[Color3]
Color=249,204,108

[Color3Intense]
Color=252,214,117

[Color4]
Color=243,141,112

[Color4Intense]
Color=248,167,136

[Color5]
Color=168,169,235

[Color5Intense]
Color=190,191,253

[Color6]
Color=133,218,204

[Color6Intense]
Color=155,241,225

[Color7]
Color=230,217,219

[Color7Intense]
Color=230,217,219

[General]
Blur=false
ColorRandomization=false
Description=OAL Ristretto
Opacity=1
Wallpaper=
