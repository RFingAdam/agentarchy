ForegroundNormal=230,217,219
ForegroundInactive=114,105,106
ForegroundActive=243,141,112
ForegroundLink=243,141,112
ForegroundVisited=168,169,235
ForegroundNegative=253,104,131
ForegroundNeutral=249,204,108
ForegroundPositive=173,218,120

