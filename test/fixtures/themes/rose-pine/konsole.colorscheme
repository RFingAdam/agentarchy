# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=25,23,36

[BackgroundIntense]
Color=20,18,29

[Foreground]
Color=224,222,244

[ForegroundIntense]
Color=242,240,251

[Color0]
Color=25,23,36

[Color0Intense]
Color=110,106,134

[Color1]
Color=235,111,146

[Color1Intense]
Color=242,135,159

[Color2]
Color=127,179,155

[Color2Intense]
Color=158,202,181

[Color3]
Color=246,193,119

[Color3Intense]
Color=249,209,153

[Color4]
Color=49,116,143

[Color4Intense]
Color=74,146,173

[Color5]
Color=196,167,231

[Color5Intense]
Color=212,189,240

[Color6]
Color=156,207,216

[Color6Intense]
Color=182,223,230

[Color7]
Color=224,222,244

[Color7Intense]
Color=242,240,251

[General]
Blur=false
ColorRandomization=false
Description=OAL Rose Pine
Opacity=1
Wallpaper=
