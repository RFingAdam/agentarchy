# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=250,244,237

[BackgroundIntense]
Color=237,231,225

[Foreground]
Color=87,82,121

[ForegroundIntense]
Color=87,82,121

[Color0]
Color=250,244,237

[Color0Intense]
Color=206,202,205

[Color1]
Color=180,99,122

[Color1Intense]
Color=180,99,122

[Color2]
Color=40,105,131

[Color2Intense]
Color=40,105,131

[Color3]
Color=234,157,52

[Color3Intense]
Color=234,157,52

[Color4]
Color=86,148,159

[Color4Intense]
Color=86,148,159

[Color5]
Color=144,122,169

[Color5Intense]
Color=144,122,169

[Color6]
Color=215,130,126

[Color6Intense]
Color=215,130,126

[Color7]
Color=87,82,121

[Color7Intense]
Color=87,82,121

[General]
Blur=false
ColorRandomization=false
Description=OAL Rose Pine
Opacity=1
Wallpaper=
