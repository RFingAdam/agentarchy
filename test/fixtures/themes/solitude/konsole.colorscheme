# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=16,19,21

[BackgroundIntense]
Color=12,14,16

[Foreground]
Color=202,204,204

[ForegroundIntense]
Color=165,174,180

[Color0]
Color=16,19,21

[Color0Intense]
Color=75,78,85

[Color1]
Color=86,93,96

[Color1Intense]
Color=222,97,69

[Color2]
Color=159,165,169

[Color2Intense]
Color=52,61,65

[Color3]
Color=217,219,220

[Color3Intense]
Color=201,194,180

[Color4]
Color=121,129,134

[Color4Intense]
Color=93,99,103

[Color5]
Color=174,174,174

[Color5Intense]
Color=154,154,154

[Color6]
Color=112,112,112

[Color6Intense]
Color=112,112,112

[Color7]
Color=202,204,204

[Color7Intense]
Color=165,174,180

[General]
Blur=false
ColorRandomization=false
Description=OAL Solitude
Opacity=1
Wallpaper=
