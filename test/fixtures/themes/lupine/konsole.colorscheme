# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=250,250,250

[BackgroundIntense]
Color=236,236,236

[Foreground]
Color=33,33,33

[ForegroundIntense]
Color=0,0,0

[Color0]
Color=250,250,250

[Color0Intense]
Color=158,158,158

[Color1]
Color=201,0,196

[Color1Intense]
Color=249,48,251

[Color2]
Color=74,47,208

[Color2Intense]
Color=159,133,224

[Color3]
Color=2,111,222

[Color3Intense]
Color=53,143,255

[Color4]
Color=50,100,235

[Color4Intense]
Color=84,130,255

[Color5]
Color=138,74,215

[Color5Intense]
Color=179,99,255

[Color6]
Color=12,103,222

[Color6Intense]
Color=57,134,255

[Color7]
Color=33,33,33

[Color7Intense]
Color=0,0,0

[General]
Blur=false
ColorRandomization=false
Description=OAL Lupine
Opacity=1
Wallpaper=
