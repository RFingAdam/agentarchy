# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=239,241,245

[BackgroundIntense]
Color=227,228,232

[Foreground]
Color=76,79,105

[ForegroundIntense]
Color=76,79,105

[Color0]
Color=239,241,245

[Color0Intense]
Color=172,176,190

[Color1]
Color=210,15,57

[Color1Intense]
Color=210,15,57

[Color2]
Color=64,160,43

[Color2Intense]
Color=64,160,43

[Color3]
Color=223,142,29

[Color3Intense]
Color=223,142,29

[Color4]
Color=30,102,245

[Color4Intense]
Color=30,102,245

[Color5]
Color=234,118,203

[Color5Intense]
Color=234,118,203

[Color6]
Color=23,146,153

[Color6Intense]
Color=23,146,153

[Color7]
Color=76,79,105

[Color7Intense]
Color=76,79,105

[General]
Blur=false
ColorRandomization=false
