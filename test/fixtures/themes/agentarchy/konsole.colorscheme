# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=21,20,18

[BackgroundIntense]
Color=16,15,13

[Foreground]
Color=207,201,191

[ForegroundIntense]
Color=242,237,229

[Color0]
Color=21,20,18

[Color0Intense]
Color=107,97,84

[Color1]
Color=226,87,74

[Color1Intense]
Color=242,110,96

[Color2]
Color=147,176,97

[Color2Intense]
Color=169,199,119

[Color3]
Color=230,183,74

[Color3Intense]
Color=245,204,99

[Color4]
Color=107,147,214

[Color4Intense]
Color=134,169,232

[Color5]
Color=180,129,207

[Color5Intense]
Color=201,154,224

[Color6]
Color=79,168,162

[Color6Intense]
Color=102,194,187

[Color7]
Color=207,201,191

[Color7Intense]
Color=242,237,229

[General]
Blur=false
ColorRandomization=false
Description=OAL Agentarchy
Opacity=1
Wallpaper=
