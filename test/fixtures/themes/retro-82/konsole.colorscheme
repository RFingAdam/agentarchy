# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=5,24,46

[BackgroundIntense]
Color=3,18,34

[Foreground]
Color=246,220,172

[ForegroundIntense]
Color=246,220,172

[Color0]
Color=5,24,46

[Color0Intense]
Color=42,107,120

[Color1]
Color=248,85,37

[Color1Intense]
Color=248,85,37

[Color2]
Color=2,131,145

[Color2Intense]
Color=2,131,145

[Color3]
Color=233,123,60

[Color3Intense]
Color=233,123,60

[Color4]
Color=63,143,138

[Color4Intense]
Color=250,169,104

[Color5]
Color=63,143,138

[Color5Intense]
Color=63,143,138

[Color6]
