# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=26,27,38

[BackgroundIntense]
Color=19,20,28

[Foreground]
Color=169,177,214

[ForegroundIntense]
Color=192,202,245

[Color0]
Color=26,27,38

[Color0Intense]
Color=65,72,104

[Color1]
Color=247,118,142

[Color1Intense]
Color=255,122,147

[Color2]
Color=158,206,106

[Color2Intense]
Color=185,242,124

[Color3]
Color=224,175,104

[Color3Intense]
Color=255,158,100

[Color4]
Color=122,162,247

[Color4Intense]
Color=125,166,255

[Color5]
Color=173,142,230

[Color5Intense]
Color=187,154,247

[Color6]
Color=68,157,171

[Color6Intense]
Color=13,185,215

[Color7]
Color=169,177,214

[Color7Intense]
Color=192,202,245

[General]
Blur=false
ColorRandomization=false
Description=OAL Tokyo Night
Opacity=1
