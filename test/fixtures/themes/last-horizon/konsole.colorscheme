# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=12,11,12

[BackgroundIntense]
Color=9,8,9

[Foreground]
Color=250,252,251

[ForegroundIntense]
Color=226,221,220

[Color0]
Color=12,11,12

[Color0Intense]
Color=88,78,81

[Color1]
Color=195,139,123

[Color1Intense]
Color=195,139,123

[Color2]
Color=135,169,176

[Color2Intense]
Color=135,169,176

[Color3]
Color=107,94,115

[Color3Intense]
Color=107,94,115

[Color4]
Color=181,151,144

[Color4Intense]
Color=181,151,144

[Color5]
Color=196,216,226

[Color5Intense]
Color=196,216,226

[Color6]
Color=165,160,182

[Color6Intense]
Color=165,160,182

[Color7]
Color=250,252,251

[Color7Intense]
Color=226,221,220

[General]
Blur=false
ColorRandomization=false
Description=OAL Last Horizon
Opacity=1
Wallpaper=
