ForegroundNormal=250,252,251
ForegroundInactive=88,78,81
ForegroundActive=181,151,144
ForegroundLink=181,151,144
ForegroundVisited=196,216,226
ForegroundNegative=195,139,123
ForegroundNeutral=107,94,115
ForegroundPositive=135,169,176

