# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=34,34,34

[BackgroundIntense]
Color=25,25,25

[Foreground]
Color=194,194,176

[ForegroundIntense]
Color=194,194,176

[Color0]
Color=34,34,34

[Color0Intense]
Color=102,102,102

[Color1]
Color=104,87,66

[Color1Intense]
Color=104,87,66

[Color2]
Color=95,135,95

[Color2Intense]
Color=95,135,95

[Color3]
Color=179,109,67

[Color3Intense]
Color=179,109,67

[Color4]
Color=120,130,75

[Color4Intense]
Color=120,130,75

[Color5]
Color=187,119,68

[Color5Intense]
Color=187,119,68

[Color6]
Color=201,165,84

[Color6Intense]
Color=201,165,84

[Color7]
Color=194,194,176

[Color7Intense]
Color=194,194,176

[General]
Blur=false
ColorRandomization=false
Description=OAL Miasma
Opacity=1
Wallpaper=
