# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=0,0,0

[BackgroundIntense]
Color=9,9,9

[Foreground]
Color=255,255,255

[ForegroundIntense]
Color=255,255,255

[Color0]
Color=0,0,0

[Color0Intense]
Color=122,122,122

[Color1]
Color=164,164,164

[Color1Intense]
Color=164,164,164

[Color2]
Color=182,182,182

[Color2Intense]
Color=182,182,182

[Color3]
Color=206,206,206

[Color3Intense]
Color=206,206,206

[Color4]
Color=141,141,141

[Color4Intense]
Color=141,141,141

[Color5]
Color=155,155,155

[Color5Intense]
Color=155,155,155

[Color6]
Color=176,176,176

[Color6Intense]
Color=176,176,176

[Color7]
Color=255,255,255

[Color7Intense]
Color=255,255,255

[General]
Blur=false
ColorRandomization=false
Description=OAL Vantablack
Opacity=1
Wallpaper=
