# Konsole colour scheme, generated from a theme's colors.toml. See plasma.colors.tpl for how this is
# rendered. ColorN is colorN and ColorNIntense is color(N+8): the same sixteen ANSI colours the
# terminal templates in this directory use, so Konsole and Ghostty cannot drift apart.

[Background]
Color=22,36,45

[BackgroundIntense]
Color=16,27,33

[Foreground]
Color=214,226,238

[ForegroundIntense]
Color=242,252,255

[Color0]
Color=22,36,45

[Color0Intense]
Color=48,72,96

[Color1]
Color=77,134,176

[Color1Intense]
Color=115,166,203

[Color2]
Color=94,149,188

[Color2Intense]
Color=134,183,216

[Color3]
Color=111,164,201

[Color3Intense]
Color=157,202,229

[Color4]
Color=111,184,227

[Color4Intense]
Color=242,252,255

[Color5]
Color=139,201,235

[Color5Intense]
Color=177,216,238

[Color6]
Color=180,228,246

[Color6Intense]
Color=209,238,248

[Color7]
Color=214,226,238

[Color7Intense]
Color=242,252,255

[General]
Blur=false
ColorRandomization=false
Description=OAL Lumon
Opacity=1
Wallpaper=
