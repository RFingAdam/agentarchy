#!/usr/bin/env bash
# The Phase 1 golden path, end to end and unattended: a pristine Arch cloud image becomes an
# installed Agentarchy that reboots into a themed Plasma 6 Wayland session and passes every
# assertion in test/vm/assertions.sh.
# Usage: golden-path [--keep] [--theme NAME] [--timeout SECONDS]
#
#   --keep           leave the VM running afterwards (default: shut it down)
#   --theme NAME     theme to apply in the live session (default: tokyo-night)
#   --timeout N      seconds to wait for ssh after a boot or reboot (default 300)
#
# Evidence lands in .vm/artifacts/<timestamp>/: bootstrap.log, assertions.txt, the two screenshots
# and a timings file. Nothing here runs in CI -- there is no VM on a GitHub runner -- so this is the
# command a human (or an agent with a host) runs before calling a phase done.
set -euo pipefail
# shellcheck source=test/vm/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
keep=0
theme="tokyo-night"
timeout=300
while (($#)); do
  case "$1" in
    --keep) keep=1; shift ;;
    --theme) theme="${2:-}"; [[ -n "$theme" ]] || vm_die "--theme wants a name"; shift 2 ;;
    --timeout) timeout="${2:-}"; [[ "$timeout" =~ ^[0-9]+$ ]] || vm_die "--timeout wants seconds"; shift 2 ;;
    -h | --help) sed -n '2,13p' "$0"; exit 0 ;;
    *) vm_die "unknown argument: $1 (see --help)" ;;
  esac
done

stamp="$(date +%Y%m%d-%H%M%S)"
art="$VM_DIR/artifacts/$stamp"
mkdir -p -- "$art"

timings=()
overall_start=$SECONDS

# Stage boundaries are where a failure gets its name, and the per-stage seconds are the only way to
# notice that "it still works" now takes twice as long as it did.
stage() {
  local name="$1"; shift
  local start=$SECONDS rc=0
  printf '\n==> %s\n' "$name" >&2
  "$@" || rc=$?
  timings+=("$(printf '%-10s %4ds' "$name" "$((SECONDS - start))")")
  return "$rc"
}

# A failed run that says only "failed" costs a whole rerun to diagnose, so spend the ten seconds now.
diagnose() {
  vm_serial_tail 40
  printf -- '--- guest journal (last 50 lines) ---\n' >&2
  vm_ssh 'journalctl -b --no-pager 2>/dev/null | tail -n 50' >&2 2>/dev/null \
    || printf 'vm: guest is unreachable, journal unavailable\n' >&2
}

finish() {
  local rc="$1" verdict="$2"
  {
    printf 'golden-path %s\n\n' "$verdict"
    printf '%s\n' "${timings[@]}"
    printf '%-10s %4ds\n' total "$((SECONDS - overall_start))"
  } | tee "$art/timings.txt" >&2
  printf '\nartifacts: %s\n' "$art" >&2
  if (( keep )); then
    vm_log "--keep: the VM is still running on ssh port $(vm_port 2>/dev/null || echo '?') (test/vm/vm-ssh, test/vm/vm-down)"
  else
    "$here/vm-down" >/dev/null 2>&1 || true
  fi
  exit "$rc"
}

fail() { local what="$1"; printf '\ngolden-path: FAILED at %s\n' "$what" >&2; diagnose; finish 1 "FAILED at $what"; }

# --- 1. a pristine guest -------------------------------------------------------------------------

stage boot "$here/vm-up" --fresh --timeout "$timeout" || fail boot

# --- 2. the checkout under test ------------------------------------------------------------------

stage sync "$here/vm-sync" || fail sync

# --- 3. install ----------------------------------------------------------------------------------

bootstrap() { vm_ssh "cd '$VM_GUEST_REPO' && ./oal-bootstrap.sh" >"$art/bootstrap.log" 2>&1; }
if ! stage bootstrap bootstrap; then
  printf -- '--- bootstrap.log (last 30 lines) ---\n' >&2
  tail -n 30 -- "$art/bootstrap.log" >&2
  fail bootstrap
fi

# --- 4. reboot into the desktop ------------------------------------------------------------------

# The reboot is the assertion, not a formality: it is where the display manager, the default target,
# the firewall and the new kernel first meet. Phase 1's worst bug (ufw closing 22) only appeared here.
reboot_guest() {
  vm_ssh 'sudo systemctl reboot' >/dev/null 2>&1 || true
  sleep 10                     # let sshd go down, or we would "succeed" against the dying session
  vm_wait_ssh "$timeout"
}
stage reboot reboot_guest || fail reboot

# SDDM autologin, the compositor and plasmashell come up over some seconds after ssh answers.
settle() {
  local i
  for ((i = 0; i < 30; i++)); do
    vm_ssh 'systemctl --user is-active plasma-plasmashell.service' >/dev/null 2>&1 && return 0
    sleep 4
  done
  return 1
}
stage session settle || fail "session (plasmashell never became active)"

# --- 5. assertions -------------------------------------------------------------------------------

assertions() { vm_ssh bash -s <"$here/assertions.sh" >"$art/assertions.txt" 2>&1; }
stage assert assertions || { cat -- "$art/assertions.txt" >&2; fail assertions; }
cat -- "$art/assertions.txt" >&2

# --- 6. theme the live session and photograph it --------------------------------------------------

# The bootstrap already wrote the colour scheme (assertions check kdeglobals), but the wallpaper
# needs a running shell, so it is applied here -- after the assertions, so they judge the install.
theme_live() {
  vm_ssh "export XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0; oal-theme-set-kde '$theme'"
}
stage theme theme_live || vm_warn "theming the live session failed; continuing to the screenshots"

shots() {
  sleep 3   # let the wallpaper transition finish before the shutter
  "$here/vm-shot" "$art/desktop-qmp.png" && "$here/vm-shot" "$art/desktop-guest.png" --guest
}
stage shots shots || fail screenshots

# A screenshot is only evidence if it is a real frame; a black or 1 KB image means the compositor
# never rendered, which has happened and passed every other check. Its size is evidence too: the QMP
# shot is the framebuffer and the --guest shot is what KWin actually painted, so both of them
# matching the resolution the VM was booted with is what proves the desktop is really full size,
# rather than the 1280x800 one virtio-gpu hands out when nobody tells it otherwise.
want_res="${VM_XRES}x${VM_YRES}"
for shot in "$art/desktop-qmp.png" "$art/desktop-guest.png"; do
  bytes="$(stat -c %s -- "$shot")"
  mean="$(magick identify -format '%[mean]' "$shot" 2>/dev/null || echo 0)"
  dims="$(magick identify -format '%wx%h' "$shot" 2>/dev/null || echo '?')"
  printf '%s %s bytes mean=%s %s\n' "$(basename -- "$shot")" "$bytes" "$mean" "$dims" >&2
  (( bytes > 50000 )) || fail "screenshot $(basename -- "$shot") is only $bytes bytes"
  awk -v m="$mean" 'BEGIN { exit !(m > 1000) }' || fail "screenshot $(basename -- "$shot") is a blank frame (mean $mean)"
  [[ $dims == "$want_res" ]] || fail "screenshot $(basename -- "$shot") is $dims, not the $want_res this VM was booted with"
done

printf '\ngolden-path: PASS\n' >&2
finish 0 PASS
