#!/usr/bin/env bash
# The Phase 1 golden path, end to end and unattended: a pristine Arch cloud image becomes an
# installed Agentarchy that reboots into a themed Plasma 6 Wayland session and passes every
# assertion in test/vm/assertions.sh.
# Usage: golden-path [--keep] [--theme NAME] [--timeout SECONDS]
#
#   --keep           leave the VM running afterwards (default: shut it down)
#   --theme LIST     comma-separated themes to cycle in the live session
#                    (default: agentarchy,gruvbox,white -- ours first, and the last one light)
#   --no-greeter     skip the login-screen stage (which costs one extra reboot)
#   --timeout N      seconds to wait for ssh after a boot or reboot (default 300)
#
# Evidence lands in .vm/artifacts/<timestamp>/: bootstrap.log, assertions.txt, a screenshot pair per
# theme, theme-<slug>.txt beside each, the greeter shot, and a timings file. Nothing here runs in CI -- there is no VM on a GitHub runner -- so this is the
# command a human (or an agent with a host) runs before calling a phase done.
set -euo pipefail
# shellcheck source=test/vm/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
keep=0
themes="agentarchy,gruvbox,white"
greeter=1
timeout=300
while (($#)); do
  case "$1" in
    --keep) keep=1; shift ;;
    --theme) themes="${2:-}"; [[ -n "$themes" ]] || vm_die "--theme wants a name or a comma-separated list"; shift 2 ;;
    --no-greeter) greeter=0; shift ;;
    --timeout) timeout="${2:-}"; [[ "$timeout" =~ ^[0-9]+$ ]] || vm_die "--timeout wants seconds"; shift 2 ;;
    -h | --help) sed -n '2,16p' "$0"; exit 0 ;;
    *) vm_die "unknown argument: $1 (see --help)" ;;
  esac
done

stamp="$(date +%Y%m%d-%H%M%S)"
art="$VM_DIR/artifacts/$stamp"
mkdir -p -- "$art"

timings=()
overall_start=$SECONDS

# Stage boundaries are where a failure gets its name, and the per-stage seconds are the only way to
# notice that "it still works" now takes twice as long as it did.
stage() {
  local name="$1"; shift
  local start=$SECONDS rc=0
  printf '\n==> %s\n' "$name" >&2
  "$@" || rc=$?
  timings+=("$(printf '%-10s %4ds' "$name" "$((SECONDS - start))")")
  return "$rc"
}

# A failed run that says only "failed" costs a whole rerun to diagnose, so spend the ten seconds now.
diagnose() {
  vm_serial_tail 40
  printf -- '--- guest journal (last 50 lines) ---\n' >&2
  vm_ssh 'journalctl -b --no-pager 2>/dev/null | tail -n 50' >&2 2>/dev/null \
    || printf 'vm: guest is unreachable, journal unavailable\n' >&2
}

finish() {
  local rc="$1" verdict="$2"
  {
    printf 'golden-path %s\n\n' "$verdict"
    printf '%s\n' "${timings[@]}"
    printf '%-10s %4ds\n' total "$((SECONDS - overall_start))"
  } | tee "$art/timings.txt" >&2
  printf '\nartifacts: %s\n' "$art" >&2
  if (( keep )); then
    vm_log "--keep: the VM is still running on ssh port $(vm_port 2>/dev/null || echo '?') (test/vm/vm-ssh, test/vm/vm-down)"
  else
    "$here/vm-down" >/dev/null 2>&1 || true
  fi
  exit "$rc"
}

fail() { local what="$1"; printf '\ngolden-path: FAILED at %s\n' "$what" >&2; diagnose; finish 1 "FAILED at $what"; }

# --- 1. a pristine guest -------------------------------------------------------------------------

stage boot "$here/vm-up" --fresh --timeout "$timeout" || fail boot

# --- 2. the checkout under test ------------------------------------------------------------------

stage sync "$here/vm-sync" || fail sync

# --- 3. install ----------------------------------------------------------------------------------

bootstrap() { vm_ssh "cd '$VM_GUEST_REPO' && ./oal-bootstrap.sh" >"$art/bootstrap.log" 2>&1; }
if ! stage bootstrap bootstrap; then
  printf -- '--- bootstrap.log (last 30 lines) ---\n' >&2
  tail -n 30 -- "$art/bootstrap.log" >&2
  fail bootstrap
fi

# --- 4. reboot into the desktop ------------------------------------------------------------------

# The reboot is the assertion, not a formality: it is where the display manager, the default target,
# the firewall and the new kernel first meet. Phase 1's worst bug (ufw closing 22) only appeared here.
reboot_guest() {
  vm_ssh 'sudo systemctl reboot' >/dev/null 2>&1 || true
  sleep 10                     # let sshd go down, or we would "succeed" against the dying session
  vm_wait_ssh "$timeout"
}
stage reboot reboot_guest || fail reboot

# SDDM autologin, the compositor and plasmashell come up over some seconds after ssh answers.
settle() {
  local i
  for ((i = 0; i < 30; i++)); do
    vm_ssh 'systemctl --user is-active plasma-plasmashell.service' >/dev/null 2>&1 && return 0
    sleep 4
  done
  return 1
}
stage session settle || fail "session (plasmashell never became active)"

# --- 5. assertions -------------------------------------------------------------------------------

assertions() { vm_ssh bash -s <"$here/assertions.sh" >"$art/assertions.txt" 2>&1; }
stage assert assertions || { cat -- "$art/assertions.txt" >&2; fail assertions; }
cat -- "$art/assertions.txt" >&2

# --- 6. cycle the themes and photograph each one --------------------------------------------------

# The bootstrap already wrote the colour scheme (the assertions above check kdeglobals), but the
# wallpaper needs a running shell, so theming happens here -- after the assertions, so those judge
# the install rather than this. Each theme is applied, checked, and photographed in turn: cycling is
# the case that finds a half-applied theme, because the second theme has to overwrite the first
# everywhere, and anything it misses stays visibly on the previous palette.
IFS=',' read -r -a theme_list <<<"$themes"
shots=()

theme_cycle() {
  local slug rc=0
  for slug in "${theme_list[@]}"; do
    [[ -n "$slug" ]] || continue
    printf -- '--- %s ---\n' "$slug" >&2
    # oal-theme-set, not oal-theme-set-kde: this is the command a user actually runs, and since
    # patch 0012 it is the one that drives both halves -- the desktop through oal-theme-set-kde and
    # the eighteen templated configs through the template pass. Cycling with the KDE command alone
    # moved the desktop and left every terminal, editor and prompt on the previous theme, which is
    # exactly the split this stage is here to catch.
    # Through a login shell. oal-theme-set is vendored and reads $OAL_PATH bare, which
    # /etc/profile.d/oal.sh exports into login shells and an ssh command line does not have -- so a
    # bare invocation answers "Theme does not exist" for every theme on a perfectly good machine.
    # A user's terminal is a login shell, so this tests the chain they actually use, profile.d
    # included, rather than papering over it by exporting the variable here.
    vm_ssh "export XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0; bash -lc 'oal-theme-set \"$slug\"'" \
      >>"$art/theme-$slug.txt" 2>&1 || { vm_warn "applying $slug failed"; rc=1; }
    sleep 3   # let the wallpaper land before the shutter
    vm_ssh bash -s -- "$slug" <"$here/theme-assertions.sh" >>"$art/theme-$slug.txt" 2>&1 || rc=1
    tail -n 20 -- "$art/theme-$slug.txt" >&2
    "$here/vm-shot" "$art/theme-$slug-qmp.png" || return 1
    "$here/vm-shot" "$art/theme-$slug-guest.png" --guest || return 1
    shots+=("$art/theme-$slug-qmp.png" "$art/theme-$slug-guest.png")
  done
  return "$rc"
}
stage themes theme_cycle || fail "theme cycle (see $art/theme-*.txt)"

# --- 6b. the agent layer, and the prompt that shows it ---------------------------------------------

# The agent runtime install is deliberately non-fatal (install/agent/runtime.sh), so this stage
# reports what it found rather than failing when a third party's installer had a bad afternoon. What
# it does insist on is the parts this repository owns: the catalog, the posture, and a prompt that
# renders from the current theme.
agent_layer() {
  local rc=0
  vm_ssh bash -s <<'GUEST' >"$art/agent.txt" 2>&1 || rc=1
set -u
pass=0; fail=0
ok()  { printf 'PASS %s\n' "$1"; pass=$((pass + 1)); }
bad() { printf 'FAIL %s: %s\n' "$1" "${2:-}"; fail=$((fail + 1)); }

command -v oal-mcp-list >/dev/null && ok mcp-commands-installed || bad mcp-commands-installed "not on PATH"

n="$(oal-mcp-list | tail -n +2 | grep -c .)"
[ "$n" -ge 8 ] && ok "catalog-visible ($n servers)" || bad catalog-visible "only $n rows"

# The posture is ours and must work with or without a runtime.
oal-agent-profile untrusted >/dev/null 2>&1 && [ "$(oal-agent-profile)" = untrusted ] &&
  oal-agent-profile scoped >/dev/null 2>&1 && [ "$(oal-agent-profile)" = scoped ] &&
  ok agent-profile-round-trip || bad agent-profile-round-trip "$(oal-agent-profile 2>&1)"

# The prompt config has to exist and be the themed one, not starship's defaults.
cfg="$HOME/.local/state/oal/current/theme/starship.toml"
if [ -s "$cfg" ]; then
  ok prompt-rendered
  grep -q 'oal-agent-hud' "$cfg" && ok prompt-carries-hud || bad prompt-carries-hud "no custom.agent block"
  # It must be this theme's colours, not the last one's.
  bg="$(oal-theme-color --file "$HOME/.local/state/oal/current/theme/colors.toml" background)"
  grep -qF "$bg" "$cfg" && ok prompt-matches-theme || bad prompt-matches-theme "no $bg in the prompt config"
else
  bad prompt-rendered "no $cfg"
fi

# STARSHIP_CONFIG is exported by default/bash/envs, which ~/.bashrc sources. That makes it an
# interactive-shell thing: `bash -lc` is a login shell but not an interactive one and never reads
# bashrc at all, so it reports the variable missing on a machine where it is set correctly.
sc="$(bash -ic 'printf %s "$STARSHIP_CONFIG"' 2>/dev/null)"
[ "$sc" = "$cfg" ] && ok starship-config-env || bad starship-config-env "got '$sc'"

if command -v claude >/dev/null; then
  ok agent-runtime-present
  oal-mcp-install --profile minimal >/dev/null 2>&1 || true
  c="$(oal-mcp-status --count)"
  [ "$c" -ge 1 ] && ok "mcp-registered ($c)" || bad mcp-registered "count $c"
else
  # Non-fatal, and everything of ours still has to be in place. A failed third-party installer that
  # also silently skips the guard, the posture and the timer is not "non-fatal", it is half an
  # install reported as a success.
  printf 'INFO agent runtime absent -- install/agent/runtime.sh is non-fatal by design\n'
fi

# The guard: installed, registered, and actually refusing. A hook that is present but not wired
# into settings.json is never consulted, and looks fine from every angle except the one that matters.
guard=/usr/share/agentarchy/agent/hooks/pretooluse-guard
[ -x "$guard" ] && ok guard-installed || bad guard-installed "not executable at $guard"
if command -v jq >/dev/null && [ -f "$HOME/.claude/settings.json" ]; then
  jq -e --arg g "$guard" '.hooks.PreToolUse[]?.hooks[]? | select(.command == $g)' \
    "$HOME/.claude/settings.json" >/dev/null 2>&1 &&
    ok guard-registered || bad guard-registered "not in .hooks.PreToolUse"
else
  bad guard-registered "no settings.json to check"
fi
# Assembled, so this file does not contain the literal pattern and trip other guards.
danger="$(printf 'rm -%sf /' r)"
verdict="$(jq -nc --arg c "$danger" '{tool_name:"Bash", tool_input:{command:$c}}' | "$guard" |
  jq -r '.hookSpecificOutput.permissionDecision' 2>/dev/null)"
[ "$verdict" = deny ] && ok guard-refuses || bad guard-refuses "verdict was '$verdict'"

oal-agent-hud --refresh >/dev/null 2>&1 || true
printf 'HUD: [%s]\n' "$(oal-agent-hud)"

printf '\n%d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
GUEST
  cat -- "$art/agent.txt" >&2
  return "$rc"
}
stage agent agent_layer || fail "agent layer (see $art/agent.txt)"

# A terminal, photographed, because the prompt is a visual thing and no assertion covers how it looks.
prompt_shot() {
  # Back to the default theme first. The cycle above ends on whichever theme is last in the list, so
  # without this the one screenshot of the prompt is of an arbitrary theme -- and the list ends light
  # on purpose, which is the least representative of the twenty.
  vm_ssh "export XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0; bash -lc 'oal-theme-set agentarchy'" >/dev/null 2>&1 || true
  sleep 2
  vm_ssh_session 'setsid konsole >/dev/null 2>&1 &' >/dev/null 2>&1 || true
  sleep 8
  # The window has to exist before it is worth photographing. Without this the stage happily
  # produced a picture of an empty desktop and called it a picture of the prompt.
  vm_ssh 'pgrep -x konsole >/dev/null' >/dev/null 2>&1 ||
    { vm_warn "konsole did not start; not photographing an empty desktop"; return 1; }
  "$here/vm-shot" "$art/prompt-guest.png" --guest || return 1
  shots+=("$art/prompt-guest.png")
}
stage prompt prompt_shot || vm_warn "could not photograph the prompt; continuing"

# The brain contract, end to end against the stub adapter. The stub exists so this can be answered
# on a machine with no runtime, no network and no account -- if the check needed a real backend, a
# failure would never distinguish "the contract is broken" from "the gateway is down".
brain_layer() {
  vm_ssh bash -s <<'GUEST' >"$art/brain.txt" 2>&1 || return 1
set -u
export OAL_PATH=/usr/share/agentarchy

# Nothing is on until someone turns it on. This is the claim the whole design rests on, so it is
# checked before anything here turns anything on.
[ -z "$(oal-brain-backend)" ] &&
  echo "PASS brain-none-by-default" || { echo "FAIL brain-none-by-default: a backend is configured"; exit 1; }
[ -z "$(oal-brain-status)" ] &&
  echo "PASS brain-status-quiet" || { echo "FAIL brain-status-quiet: status spoke with no backend"; exit 1; }
systemctl --user is-enabled oal-brain.service >/dev/null 2>&1 &&
  { echo "FAIL brain-service-not-enabled: the resident service is enabled"; exit 1; } ||
  echo "PASS brain-service-not-enabled"

oal-brain-backend stub >/dev/null || { echo "FAIL brain-select: could not select the stub"; exit 1; }
echo "PASS brain-select"

# --no-context so this measures the pipe and nothing else. A question about this machine now
# arrives at the backend with the machine's state attached, which the machine stage below checks.
answer="$(oal-brain-ask --no-context 'what theme am I using')"
[ "$answer" = "stub: what theme am I using" ] &&
  echo "PASS brain-round-trip" || { echo "FAIL brain-round-trip: got '$answer'"; exit 1; }

oal-brain-do state | grep -q '^host:' &&
  echo "PASS brain-verb-runs" || { echo "FAIL brain-verb-runs: state produced nothing"; exit 1; }

# The boundary, on the real machine rather than in a fixture: a verb nobody put in the set.
oal-brain-do reboot >/dev/null 2>&1 &&
  { echo "FAIL brain-refuses-unknown-verb: 'reboot' was accepted"; exit 1; } ||
  echo "PASS brain-refuses-unknown-verb"

# A job you walk away from, and what a restart does to it.
task="$(oal-brain-run 'count to three')"
for _ in $(seq 1 40); do
  case "$(oal-brain-tasks | awk -v i="$task" '$1 == i {print $2}')" in
    running|starting|"") sleep 0.5 ;;
    *) break ;;
  esac
done
[ "$(oal-brain-tasks | awk -v i="$task" '$1 == i {print $2}')" = done ] &&
  echo "PASS brain-task-runs" || { echo "FAIL brain-task-runs: task did not reach done"; exit 1; }

# Put it back to running, owned by a live pid, from a boot that is not this one -- which is what a
# task looks like after the machine restarted under it.
d="$HOME/.local/state/oal/brain/tasks/$task"
before="$(cat "$d/output")"
printf 'state=running
pid=1
boot=00000000-0000-0000-0000-000000000000
' >>"$d/meta"
oal-brain-sweep | grep -q interrupted &&
  echo "PASS brain-task-held" || { echo "FAIL brain-task-held: the sweep did not report it"; exit 1; }
[ "$(cat "$d/output")" = "$before" ] &&
  echo "PASS brain-task-not-resumed" || { echo "FAIL brain-task-not-resumed: the sweep restarted work"; exit 1; }

# The desktop end of the contract: a question asked without a terminal open. The shortcut binds by
# desktop entry id, so the entry has to be where a desktop environment reads them -- the same gap
# that left the dock's first icon dead.
[ -f /usr/share/applications/oal-ask.desktop ] &&
  echo "PASS brain-ask-entry" || { echo "FAIL brain-ask-entry: oal-ask.desktop is not installed"; exit 1; }
# A general question, so the round trip through the desktop path is byte-exact. Anything about this
# machine now arrives at the backend with the machine's state attached, which the machine stage
# below checks on its own terms. "what theme am I using" used to be the question here and is exactly
# the kind that is now grounded.
answer="$(oal-ask 'what is the capital of Peru')"
[ "$answer" = "stub: what is the capital of Peru" ] &&
  echo "PASS brain-ask-desktop" || { echo "FAIL brain-ask-desktop: got '$answer'"; exit 1; }
[ -s "$HOME/.local/state/oal/last-answer.txt" ] &&
  echo "PASS brain-ask-answer-kept" || { echo "FAIL brain-ask-answer-kept: nothing written"; exit 1; }

# Leave the machine as the install left it. A test that configures a brain and walks away has
# changed the thing the next stage is measuring.
oal-brain-backend --none >/dev/null
[ -z "$(oal-brain-backend)" ] &&
  echo "PASS brain-reset" || { echo "FAIL brain-reset: a backend is still configured"; exit 1; }
GUEST
  cat -- "$art/brain.txt" >&2
}
stage brain brain_layer || fail "the brain contract (see $art/brain.txt)"

# --- 6c-bis. the machine answering for itself --------------------------------------------------------

# oal-doctor, the grounding it feeds, the watcher that reads it, and the MCP server that serves it.
# Run in the guest because almost none of it is meaningful anywhere else: pacman, systemd units and
# a real journal are the things being asked about.
machine_answers() {
  vm_ssh bash -s <<'GUEST' >"$art/machine.txt" 2>&1 || return 1
set -u
export OAL_PATH=/usr/share/agentarchy

# --- the report --------------------------------------------------------------------------------
report="$(oal-doctor --json)"; rc=$?
[ "$rc" -le 2 ] &&
  echo "PASS doctor-exits-with-a-verdict ($rc)" || { echo "FAIL doctor-exits-with-a-verdict: $rc"; exit 1; }
printf '%s' "$report" | jq -e . >/dev/null 2>&1 &&
  echo "PASS doctor-json-valid" || { echo "FAIL doctor-json-valid"; exit 1; }
printf '%s' "$report" | jq -e 'all(.checks[]; has("id") and has("severity") and has("summary"))' >/dev/null &&
  echo "PASS doctor-json-shape" || { echo "FAIL doctor-json-shape"; exit 1; }

# On Arch, with a real pacman, these three must actually run rather than report unknown. That is the
# half of oal-doctor the unit suite cannot reach, because CI has no pacman.
for id in updates orphans pacnew; do
  sev="$(printf '%s' "$report" | jq -r --arg i "$id" '.checks[]|select(.id==$i)|.severity')"
  [ "$sev" != unknown ] &&
    echo "PASS doctor-runs-$id ($sev)" || { echo "FAIL doctor-runs-$id: unknown on a machine with pacman"; exit 1; }
done

# It is read on a timer and injected into prompts, so it has a latency budget like the prompt does.
start=$(date +%s%N); oal-doctor --quiet; end=$(date +%s%N)
ms=$(( (end - start) / 1000000 ))
echo "INFO doctor-latency ${ms}ms"
[ "$ms" -lt 10000 ] &&
  echo "PASS doctor-is-not-slow" || { echo "FAIL doctor-is-not-slow: ${ms}ms"; exit 1; }

# --- grounding ---------------------------------------------------------------------------------
oal-brain-backend stub >/dev/null
grounded="$(oal-brain-ask 'are there any OS issues?')"
case "$grounded" in
  *"facts about the machine"*) echo "PASS ask-is-grounded" ;;
  *) echo "FAIL ask-is-grounded: got '$grounded'"; exit 1 ;;
esac
# And it carries a fact from this machine, not a template.
case "$grounded" in
  *"host: $(uname -n)"*) echo "PASS ask-carries-real-facts" ;;
  *) echo "FAIL ask-carries-real-facts: no hostname in the context"; exit 1 ;;
esac
# The theme is a fact injected into every grounded question, and it was wrong: current/theme is a
# directory here rather than upstream's symlink, so resolving the path reported the theme as
# "theme". A machine with a theme installed is the only place that shows.
case "$grounded" in
  *"theme: theme"*) echo "FAIL ask-theme-is-a-theme: the context calls the theme 'theme'"; exit 1 ;;
  *"theme: $(oal-theme-current)"*) echo "PASS ask-theme-is-a-theme ($(oal-theme-current))" ;;
  *) echo "FAIL ask-theme-is-a-theme: no theme in the context"; exit 1 ;;
esac

plain="$(oal-brain-ask 'who wrote Hamlet?')"
[ "$plain" = "stub: who wrote Hamlet?" ] &&
  echo "PASS ask-leaves-general-questions-alone" || { echo "FAIL ask-leaves-general-questions-alone: got '$plain'"; exit 1; }

# --- the root that was missing -------------------------------------------------------------------
command -v oal-agent >/dev/null &&
  echo "PASS agent-resolves" || { echo "FAIL agent-resolves: oal-agent is not on PATH"; exit 1; }
# The alias every shell carries. `a` was bound to a command that did not exist.
bash -lc 'type a' 2>/dev/null | grep -q 'oal-agent' &&
  echo "PASS agent-alias-bound" || echo "WARN agent-alias-bound: 'a' is not aliased in a login shell"
oal-agent-crash 2>&1 | grep -qi usage &&
  echo "PASS agent-crash-resolves" || { echo "FAIL agent-crash-resolves: exit 127 territory"; exit 1; }
oal-agent-diagnose not-a-check 2>&1 | grep -q 'Known checks:' &&
  echo "PASS agent-diagnose-resolves" || { echo "FAIL agent-diagnose-resolves"; exit 1; }

# --- the watcher ---------------------------------------------------------------------------------
oal-watch --reset >/dev/null
first="$(oal-watch --once)"
second="$(oal-watch --once)"
[ -z "$second" ] &&
  echo "PASS watch-announces-transitions-only" || { echo "FAIL watch-announces-transitions-only: repeated '$second'"; exit 1; }
systemctl --user is-enabled oal-watch.timer >/dev/null 2>&1 &&
  echo "PASS watch-timer-enabled" || echo "WARN watch-timer-enabled: not enabled in this session"
systemctl --user is-enabled oal-crash-watch.service >/dev/null 2>&1 &&
  echo "PASS crash-watch-enabled" || { echo "FAIL crash-watch-enabled: the install did not enable it"; exit 1; }

# --- a real crash, taking the real path ------------------------------------------------------------
# The whole feature is that clicking the notification does something. Nothing short of an actual core
# dump proves the pid reaches a command that can act on it.
if command -v coredumpctl >/dev/null; then
  ( sleep 30 & echo $! >/tmp/victim; wait ) >/dev/null 2>&1 &
  sleep 1
  victim="$(cat /tmp/victim 2>/dev/null)"
  kill -SEGV "$victim" 2>/dev/null
  sleep 3
  if coredumpctl list "$victim" --no-pager --no-legend >/dev/null 2>&1; then
    echo "PASS crash-dumped-core"
    # The exact string oal-crash-watch hands the notification daemon.
    oal-agent-crash "$victim" sleep /usr/bin/sleep SIGSEGV 2>&1 | grep -q 'oal-brain-backend' &&
      echo "PASS crash-click-reaches-the-agent" ||
      { echo "FAIL crash-click-reaches-the-agent: the click target did not run"; exit 1; }
  else
    echo "WARN crash-dumped-core: systemd-coredump recorded nothing"
  fi
else
  echo "WARN crash-dumped-core: no coredumpctl"
fi

# --- the machine as an MCP server -------------------------------------------------------------------
frames="$(printf '%s
'   '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{}}}'   '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'   '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"os_status","arguments":{}}}'   | oal-mcp-serve 2>/dev/null)"
[ "$(printf '%s
' "$frames" | wc -l)" = 3 ] &&
  echo "PASS mcp-serve-answers" || { echo "FAIL mcp-serve-answers: got $(printf '%s
' "$frames" | wc -l) frames"; exit 1; }
printf '%s
' "$frames" | while IFS= read -r f; do printf '%s' "$f" | jq -e . >/dev/null || exit 1; done &&
  echo "PASS mcp-frames-valid" || { echo "FAIL mcp-frames-valid"; exit 1; }
printf '%s
' "$frames" | jq -r 'select(.id==3)|.result.content[0].text' | grep -q 'failed-units' &&
  echo "PASS mcp-os-status-is-the-real-report" || { echo "FAIL mcp-os-status-is-the-real-report"; exit 1; }

oal-brain-backend --none >/dev/null
GUEST
}
stage machine machine_answers || fail "the machine answering for itself (see $art/machine.txt)"

# --- 6d. panel layouts ------------------------------------------------------------------------------

# Both presets, applied to the live session and photographed. The count comes from Plasma itself
# rather than from parsing appletsrc: the config file's panel encoding is an implementation detail
# and the script API is the same surface oal-layout-set uses to apply them.
layouts() {
  local rc=0 name want
  # mint first. ubuntu is the layout already in place, so applying it first changes nothing on
  # screen and its screenshot came out byte-identical to the previous stage's -- a picture that
  # proved the panel count only because the assertion beside it did. Going away and coming back
  # makes both shots evidence.
  for pair in "mint 1" "ubuntu 2"; do
    set -- $pair
    name="$1"; want="$2"
    vm_ssh "export XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0; bash -lc 'oal-layout-set $name'" \
      >>"$art/layout-$name.txt" 2>&1 || { vm_warn "applying layout $name failed"; rc=1; continue; }
    sleep 4
    local got
    got="$(vm_ssh "export XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0; qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript 'print(panels().length)'" 2>/dev/null | tr -dc '0-9')"
    if [[ $got == "$want" ]]; then
      printf 'PASS layout-%s (%s panel(s))\n' "$name" "$got" >&2
    else
      printf 'FAIL layout-%s: Plasma reports %s panels, expected %s\n' "$name" "${got:-none}" "$want" >&2
      rc=1
    fi
    "$here/vm-shot" "$art/layout-$name.png" --guest || return 1
    shots+=("$art/layout-$name.png")
  done
  # Leave it on the default, so the greeter stage and any --keep session are the shipped arrangement.
  vm_ssh "export XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0; bash -lc 'oal-layout-set ubuntu'" >/dev/null 2>&1 || true
  return "$rc"
}
stage layouts layouts || fail "panel layouts (see $art/layout-*.txt)"

# The menu, opened and photographed. It replaced a menu that was present, listed and did nothing, so
# "it opens" is the assertion that matters, and how it looks is the part only a picture answers.
menu_shot() {
  vm_ssh bash -s <<'GUEST' >"$art/menu.txt" 2>&1 || return 1
set -u
export OAL_PATH=/usr/share/agentarchy
command -v kdialog >/dev/null || { echo "FAIL menu-backend: kdialog is not installed"; exit 1; }
echo "PASS menu-backend"
# Every command the menu can invoke has to exist, or an entry is decoration.
missing=""
for c in oal-theme-set oal-layout-set oal-agent-profile oal-mcp-status oal-menu-select oal-ask loginctl; do
  command -v "$c" >/dev/null || missing="$missing $c"
done
[ -z "$missing" ] && echo "PASS menu-commands-present" || { echo "FAIL menu-commands-present:$missing"; exit 1; }
[ -s "$HOME/.local/state/oal/current/theme/fuzzel.ini" ] &&
  echo "PASS menu-themed" || { echo "FAIL menu-themed: no rendered fuzzel.ini"; exit 1; }

# Does choosing something actually do it? Every check above answers "the menu opens", and the menu
# opened fine through two separate bugs that left it doing nothing -- a dock entry the desktop never
# installed, and a keyboard binding kglobalaccel could not parse.
#
# oal-menu resolves oal-menu-select through PATH, so standing in for the picker drives the real
# dispatch and the real action without needing a keyboard. The Agent route is used because a posture
# is trivial to assert and to put back; walking the Theme route here would leave the greeter stage
# looking at a theme it did not install.
# Stand in for the PICKER, not for oal-menu-select. Shimming oal-menu-select made this a tautology:
# the shim returned the value oal-menu expected, so it passed while the real oal-menu-select handed
# back the subtext instead of the label and the menu did nothing at all. Replacing kdialog leaves
# every line of the real parsing and dispatch in the path.
mkdir -p /tmp/oal-menu-shim
rm -f /tmp/oal-menu-shim/n
cat > /tmp/oal-menu-shim/kdialog <<'SHIM'
#!/bin/bash
# Answer with a tag, as kdialog does. One index per call: Agent, then posture, then trusted.
n=$(cat /tmp/oal-menu-shim/n 2>/dev/null || echo 0)
echo $((n + 1)) > /tmp/oal-menu-shim/n
case "$n" in
  0) echo 2 ;;
  1) echo 1 ;;
  2) echo 2 ;;
  *) exit 1 ;;
esac
SHIM
chmod +x /tmp/oal-menu-shim/kdialog
before="$(oal-agent-profile)"
PATH=/tmp/oal-menu-shim:$PATH oal-menu >/dev/null 2>&1
after="$(oal-agent-profile)"
rm -rf /tmp/oal-menu-shim
oal-agent-profile "$before" >/dev/null 2>&1
if [ "$after" = trusted ] && [ "$before" != "$after" ]; then
  echo "PASS menu-selection-acts"
else
  echo "FAIL menu-selection-acts: posture went from '$before' to '$after', wanted 'trusted'"
  exit 1
fi
GUEST
  cat -- "$art/menu.txt" >&2
  vm_ssh_session 'setsid oal-menu >/dev/null 2>&1 &' >/dev/null 2>&1 || true
  sleep 6
  # Either picker: kdialog is the one that answers a mouse and fuzzel is still the fallback, so the
  # check is "a picker is on screen", not "this particular binary is running".
  vm_ssh 'pgrep -x kdialog >/dev/null || pgrep -x fuzzel >/dev/null' >/dev/null 2>&1 ||
    { vm_warn "the menu did not open; not photographing an empty desktop"; return 1; }
  "$here/vm-shot" "$art/menu-guest.png" --guest || return 1
  shots+=("$art/menu-guest.png")
  # Leave nothing open for the stages that follow.
  vm_ssh 'pkill -x kdialog; pkill -x fuzzel' >/dev/null 2>&1 || true
}
stage menu menu_shot || fail "the menu (see $art/menu.txt)"

# The ISO path, simulated. A deferred-provisioning install never runs oal-bootstrap.sh, so it never
# renders the greeter's palette -- it reaches the login screen with the theme.conf the greeter's
# theme directory ships. There is no ISO yet to install from, but the state it arrives in is one
# file, so put the guest in it and see whether the boot fixes it.
greeter_sync() {
  vm_ssh bash -s <<'GUEST' >"$art/greeter-sync.txt" 2>&1 || return 1
set -u
export OAL_PATH=/usr/share/agentarchy
conf=/usr/share/sddm/themes/oal/theme.conf
default="$(oal-theme-default)"
want="$(oal-theme-color --file "$OAL_PATH/themes/$default/colors.toml" background)"

# Exactly what an install that rendered nothing leaves behind.
sudo cp "$OAL_PATH/default/sddm/oal/theme.conf" "$conf"
grep -q '^background=' "$conf" && { echo "FAIL greeter-sync-setup: the shipped theme.conf has a palette"; exit 1; }

sudo systemctl restart oal-greeter-sync.service || { echo "FAIL greeter-sync-unit: restart failed"; exit 1; }
got="$(sed -n 's/^background=//p' "$conf")"
[ "$got" = "$want" ] &&
  echo "PASS greeter-sync-renders" ||
  {
    echo "FAIL greeter-sync-renders: background=${got:-none}, wanted $want"
    # The unit gives up quietly on purpose, so its reason is only in the journal.
    sudo journalctl -u oal-greeter-sync.service -n 20 --no-pager 2>&1 | sed 's/^/  /'
    exit 1
  }

# The other half of the contract: a palette somebody rendered on purpose is not undone at the next
# boot. Without this the unit would quietly revert every `oal-refresh-sddm <theme>` overnight.
other=gruvbox
[ "$default" = "$other" ] && other=nord
oal-refresh-sddm "$other" >/dev/null || { echo "FAIL greeter-sync-retint: oal-refresh-sddm failed"; exit 1; }
retinted="$(oal-theme-color --file "$OAL_PATH/themes/$other/colors.toml" background)"
sudo systemctl restart oal-greeter-sync.service
got="$(sed -n 's/^background=//p' "$conf")"
[ "$got" = "$retinted" ] &&
  echo "PASS greeter-sync-keeps-retint" ||
  { echo "FAIL greeter-sync-keeps-retint: the boot reverted $other to ${got:-none}"; exit 1; }

# Leave the login screen on the installed theme, so the greeter shot shows what an install shows.
oal-refresh-sddm "$default" >/dev/null
GUEST
  cat -- "$art/greeter-sync.txt" >&2
}
stage greetersync greeter_sync || fail "greeter palette sync (see $art/greeter-sync.txt)"

# --- 7. the login screen ---------------------------------------------------------------------------

# Autologin means nobody -- including every run before this one -- has ever seen the greeter. Turn it
# off, reboot into SDDM, photograph it, put it back. The QMP screendump is the only way to capture
# this: there is no session to run spectacle in.
greeter_shot() {
  # Out of the directory, not renamed inside it: SDDM reads every file it finds in a conf.d, not
  # only *.conf, so a .off suffix leaves autologin exactly as enabled as it was.
  vm_ssh 'sudo mv /etc/sddm.conf.d/10-agentarchy.conf /root/10-agentarchy.conf' >/dev/null 2>&1 || return 1
  vm_ssh 'sudo systemctl reboot' >/dev/null 2>&1 || true
  sleep 10
  vm_wait_ssh "$timeout" || return 1

  # Keep the bracket. pgrep -f matches full command lines, including the ssh command carrying this
  # pattern, so an unbracketed version always matches itself and the wait returns instantly.
  local i greeter=0
  for ((i = 0; i < 30; i++)); do
    if vm_ssh "pgrep -f '[s]ddm-greeter' >/dev/null" >/dev/null 2>&1; then greeter=1; break; fi
    sleep 4
  done
  (( greeter )) || { vm_warn "no sddm-greeter process after 120s"; return 1; }
  sleep 5   # the process exists before it has painted

  # What is on the screen, asked of logind rather than inferred. With autologin still in force the
  # screenshot below is of the desktop, and neither file size nor mean brightness can tell that from
  # a greeter.
  #
  # Scope it to seat0, the physical display. The install user always has sessions on this box --
  # this check arrives over ssh, and ssh sessions are seatless -- so counting sessions rather than
  # seat0 sessions passes on a machine that autologged straight in.
  if ! vm_ssh bash -s -- "$VM_USER" <<'ATGREETER'
set -u
sessions="$(loginctl list-sessions --no-legend 2>/dev/null)"
mine="$(awk -v u="$1" '$3 == u && $4 == "seat0"' <<<"$sessions" | wc -l)"
greeters="$(awk '$4 == "seat0" && $6 == "greeter"' <<<"$sessions" | wc -l)"
[[ $mine -eq 0 && $greeters -ge 1 ]] || { printf '%s\n' "$sessions"; exit 1; }
ATGREETER
  then
    vm_warn "seat0 is not showing a greeter (autologin still on, or the greeter never started)"
    return 1
  fi

  "$here/vm-shot" "$art/greeter-qmp.png" || return 1

  # And it has to look different from the desktop we last photographed. Byte size and mean brightness
  # cannot tell a login screen from the desktop behind it; a pixel count can.
  local last="$art/theme-${theme_list[-1]}-qmp.png"
  if [[ -f $last ]]; then
    local differing
    differing="$(magick compare -metric AE "$art/greeter-qmp.png" "$last" null: 2>&1 || true)"
    # AE reports large counts in scientific notation (1.024e+06), which no integer test matches --
    # left as-is, the comparison silently skips itself on exactly the runs it is meant to judge.
    differing="$(awk '{ printf "%.0f", $1 + 0 }' <<<"$differing" 2>/dev/null || echo 0)"
    if (( differing < 10000 )); then
      vm_warn "the greeter shot differs from $(basename -- "$last") by only $differing pixels"
      return 1
    fi
  fi
  shots+=("$art/greeter-qmp.png")

  # Put autologin back, so the disk this run leaves behind is the one the install made -- and sync,
  # because finish() powers the guest off seconds later. Without the sync the rename is still in page
  # cache when the power goes, and any copy of the resulting image boots to a greeter that a
  # cloud-image install has no password for.
  vm_ssh 'sudo mv /root/10-agentarchy.conf /etc/sddm.conf.d/10-agentarchy.conf && sync' >/dev/null 2>&1 ||
    vm_warn "could not restore autologin"
}
if (( greeter )); then
  stage greeter greeter_shot || fail "greeter screenshot"
fi

# --- 8. are the screenshots real? -------------------------------------------------------------------

# A screenshot is only evidence if it is a real frame; a black image means the compositor never
# rendered, which has happened and passed every other check.
#
# Not measured in bytes. A file size floor was the first thing here and it rejected the greeter at
# 17 KB -- flat colour and a wordmark compress to a fraction of a photographic wallpaper, and a
# threshold that admits both admits an empty frame too. Unique colours is the measure that actually
# separates "something was drawn" from "nothing was": a blank or failed capture has one or two.
for shot in "${shots[@]}"; do
  bytes="$(stat -c %s -- "$shot")"
  # The || true is not decoration: identify's -format emits no trailing newline, so read hits EOF
  # and returns non-zero even though it assigned everything -- and under set -e that ends the run
  # with no message at all, which is exactly how this loop first "passed".
  read -r geom colours mean < <(magick identify -format '%wx%h %k %[mean]' "$shot" 2>/dev/null || echo '0x0 0 0') || true
  printf '%s %s %s colours mean=%s (%s bytes)\n' "$(basename -- "$shot")" "$geom" "$colours" "$mean" "$bytes" >&2
  [[ $geom =~ ^([0-9]+)x([0-9]+)$ ]] && (( BASH_REMATCH[1] >= 640 && BASH_REMATCH[2] >= 480 )) ||
    fail "screenshot $(basename -- "$shot") is $geom"
  (( colours > 16 )) || fail "screenshot $(basename -- "$shot") has only $colours colours -- nothing was drawn"
  awk -v m="$mean" 'BEGIN { exit !(m > 1000) }' || fail "screenshot $(basename -- "$shot") is a blank frame (mean $mean)"
done

printf '\ngolden-path: PASS\n' >&2
finish 0 PASS
