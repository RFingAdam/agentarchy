#!/usr/bin/env bash
# Download and verify the Arch cloud image into .vm-cache/ (idempotent).
# Usage: vm-image [--force] [--offline]
#
#   --force    re-download even if the cached image already verifies
#   --offline  never touch the network; only verify what is cached
set -euo pipefail
# shellcheck source=test/vm/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

force=0
offline=0
while (($#)); do
  case "$1" in
    --force) force=1; shift ;;
    --offline) offline=1; shift ;;
    -h | --help) sed -n '2,7p' "$0"; exit 0 ;;
    *) vm_die "unknown argument: $1 (see --help)" ;;
  esac
done

vm_need curl sha256sum awk
sha_file="$VM_IMAGE.SHA256"

verify() {
  [[ -s "$VM_IMAGE" && -s "$sha_file" ]] || return 1
  (cd -- "$VM_CACHE" && sha256sum -c --status -- "$(basename -- "$sha_file")")
}

# The "latest" directory also holds the dated build it points at. Printing that build id (and
# comparing checksums) is how a months-old cache becomes visible instead of silently shaping every
# test run. Best effort: never fail the command because the mirror is unreachable.
report_upstream() {
  [[ $offline -eq 1 ]] && return 0
  local listing remote_sha
  listing="$(curl -fsSL --max-time 20 "$VM_IMAGE_URL_BASE/" 2>/dev/null || true)"
  if [[ -n "$listing" ]]; then
    local build
    build="$(grep -oE 'Arch-Linux-x86_64-cloudimg-[0-9]{8}\.[0-9]+\.qcow2' <<<"$listing" | head -n1)"
    build="${build#Arch-Linux-x86_64-cloudimg-}"
    [[ -n "$build" ]] && vm_log "upstream build: ${build%.qcow2}"
  else
    vm_warn "could not list $VM_IMAGE_URL_BASE/ (offline?); cannot report the upstream build"
    return 0
  fi
  remote_sha="$(curl -fsSL --max-time 20 "$VM_IMAGE_URL_BASE/$VM_IMAGE_NAME.SHA256" 2>/dev/null | awk '{print $1}' || true)"
  if [[ -n "$remote_sha" && -s "$sha_file" ]] && [[ "$remote_sha" != "$(awk '{print $1}' "$sha_file")" ]]; then
    vm_warn "cached image is STALE (upstream published a newer build) -- refresh with: $0 --force"
  fi
  return 0
}

if [[ $force -eq 0 ]] && verify; then
  vm_log "cached image verified: $VM_IMAGE ($(du -h -- "$VM_IMAGE" | awk '{print $1}'), $(date -r "$VM_IMAGE" '+%Y-%m-%d %H:%M'))"
  report_upstream
  exit 0
fi

[[ $offline -eq 1 ]] && vm_die "no valid cached image at $VM_IMAGE and --offline was given"

# ~550 MB compressed qcow2 plus room for the .part copy.
avail="$(vm_free_mb "$VM_CACHE")"
[[ "$avail" -ge 2048 ]] || vm_die "only ${avail} MB free on $VM_CACHE; need at least 2048 MB"

vm_log "downloading $VM_IMAGE_NAME from $VM_IMAGE_URL_BASE"
curl -fsSL --retry 3 --retry-delay 2 -o "$sha_file.part" "$VM_IMAGE_URL_BASE/$VM_IMAGE_NAME.SHA256"
curl -fL --retry 3 --retry-delay 2 --progress-bar -o "$VM_IMAGE.part" "$VM_IMAGE_URL_BASE/$VM_IMAGE_NAME"

expected="$(awk '{print $1}' "$sha_file.part")"
actual="$(sha256sum -- "$VM_IMAGE.part" | awk '{print $1}')"
if [[ "$expected" != "$actual" ]]; then
  rm -f -- "$VM_IMAGE.part" "$sha_file.part"
  vm_die "checksum mismatch for $VM_IMAGE_NAME (expected $expected, got $actual); download discarded"
fi

mv -f -- "$sha_file.part" "$sha_file"
mv -f -- "$VM_IMAGE.part" "$VM_IMAGE"
verify || vm_die "the freshly downloaded image does not verify; something is very wrong"
vm_log "downloaded and verified: $VM_IMAGE ($(du -h -- "$VM_IMAGE" | awk '{print $1}'))"
report_upstream
