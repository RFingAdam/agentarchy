#!/usr/bin/env bash
# Stop the test VM. Idempotent: doing nothing when nothing runs is a success.
# Usage: vm-down [--purge]
#
#   --purge  also delete the disk overlay and the UEFI variable store (next boot starts pristine)
set -euo pipefail
# shellcheck source=test/vm/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

purge=0
while (($#)); do
  case "$1" in
    --purge) purge=1; shift ;;
    -h | --help) sed -n '2,6p' "$0"; exit 0 ;;
    *) vm_die "unknown argument: $1 (see --help)" ;;
  esac
done

if vm_running; then
  pid="$(vm_pid)"
  vm_log "stopping qemu (pid $pid)"
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 30); do
    vm_running || break
    sleep 1
  done
  if vm_running; then
    vm_warn "qemu ignored SIGTERM; sending SIGKILL"
    kill -9 "$pid" 2>/dev/null || true
    sleep 1
  fi
  vm_running && vm_die "could not stop qemu (pid $pid)"
  vm_log "stopped"
else
  vm_log "no VM running"
fi

# The socket outlives the process and blocks the next boot; the pid file would make vm_running lie.
rm -f -- "$VM_QMP_SOCK" "$VM_PIDFILE"

if [[ $purge -eq 1 ]]; then
  vm_log "purging $VM_DISK and $VM_VARS"
  rm -f -- "$VM_DISK" "$VM_VARS"
fi
