#!/bin/bash

# Hermes Agent, through its command line.
#
# This adapter was originally written against a guessed HTTP gateway -- POST /v1/chat, a token, a jq
# filter over the reply -- because no instance was available to look at. None of that was right.
# Hermes drives from a CLI: `hermes -z PROMPT` answers one question, `hermes serve` is the
# JSON-RPC/WebSocket backend, `hermes gateway run` is the messaging side. The invented endpoints are
# gone rather than kept as a fallback, because an untested second path is not a safety net, it is a
# second thing to debug.
#
# Which Hermes this reaches -- local, or one on another machine -- is Hermes's own configuration, not
# ours. That is the right seam: point the CLI wherever it should go and this adapter follows.
#
# Only `ask` costs anything. `describe` and `probe` never invoke a model.
set -uo pipefail

hermes_bin() { command -v hermes >/dev/null && printf 'hermes'; }

case "${1:-}" in
  describe)
    if [[ -n "$(hermes_bin)" ]]; then
      hermes --version 2>/dev/null | head -1
    else
      echo "Hermes Agent (not installed)"
    fi
    ;;
  probe)
    # Cheap on purpose: the prompt reads this on a timer, and a probe that spent credits would be a
    # bill that grows while nobody is at the keyboard.
    [[ -n "$(hermes_bin)" ]] || exit 1
    hermes --version >/dev/null 2>&1
    ;;
  ask)
    [[ -n "$(hermes_bin)" ]] || { echo "hermes: the Hermes CLI is not installed" >&2; exit 1; }
    prompt="$(cat)"
    [[ -n $prompt ]] || { echo "hermes: empty prompt" >&2; exit 1; }
    # -z is Hermes's one-shot prompt. argv rather than stdin is safe here: this is an exec with no
    # shell in between, so the metacharacters the contract avoids by using stdin cannot bite.
    exec hermes -z "$prompt"
    ;;
  serve)
    [[ -n "$(hermes_bin)" ]] || exit 1
    # The contract asks `serve --check` before running anything, so a backend that cannot be resident
    # is not restarted every five seconds forever.
    [[ ${2:-} == --check ]] && exit 0
    # The JSON-RPC/WebSocket backend, in the foreground, which is what a systemd unit wants.
    exec hermes serve
    ;;
  *) echo "usage: hermes describe|probe|ask|serve" >&2; exit 1 ;;
esac
