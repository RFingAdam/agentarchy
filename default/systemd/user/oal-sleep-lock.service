[Unit]
Description=Lock Agentarchy before suspend
# The monitor calls into the running Agentarchy shell. Wait until UWSM has imported
# OAL_PATH and WAYLAND_DISPLAY, but keep the default target ordering so the
# monitor starts before graphical-session.target is reached.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=OAL_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/oal-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
