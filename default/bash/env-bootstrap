# Single source of truth for OAL_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/oal.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-oal          (Hyprland session via uwsm)
#   /usr/share/agentarchy/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/oal.conf is written by oal-dev-link and reset by
# oal-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/oal.conf ]; then
  . /etc/oal.conf
  : "${OAL_PATH:=/usr/share/agentarchy}"
else
  OAL_PATH=/usr/share/agentarchy
fi
export OAL_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/oal-* via the oal package — prepending
# /usr/share/agentarchy/bin would just be noise.
if [ "$OAL_PATH" != /usr/share/agentarchy ]; then
  case ":$PATH:" in
    *":${OAL_PATH%/}/bin:"*) ;;
    *) PATH="${OAL_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
