#!/bin/bash

# oal:summary=Send an Agentarchy desktop notification
# oal:args=[--exec <command>] [--app-name <app-name>] [-g <glyph>] [-u <low|normal|critical>] [--image <path-or-uri>] <headline> [description] [notify-send options]
# oal:examples=oal notification send "Reminder" "5 minutes are up" -g 󰢌

set -euo pipefail

headline=""
description=""
glyph=
urgency="low"
app_name="oal-action"
image=
exec_command=
args=()
parsed_option_args=0

parse_oal_option() {
  case $1 in
  -g | --glyph)
    if (($# < 2)); then
      echo "Missing value for $1" >&2
      exit 1
    fi
    # Accepted and deliberately unused: see the note further down about the oal-glyph hint. The
    # flag stays so that two dozen call sites do not have to change over a decoration.
    # shellcheck disable=SC2034
    glyph=$2
    parsed_option_args=2
    return 0
    ;;
  -u | --urgency)
    if (($# < 2)); then
      echo "Missing value for $1" >&2
      exit 1
    fi
    urgency="$2"
    parsed_option_args=2
    return 0
    ;;
  --app-name)
    if (($# < 2)); then
      echo "Missing value for $1" >&2
      exit 1
    fi
    app_name=$2
    parsed_option_args=2
    return 0
    ;;
  --image)
    if (($# < 2)); then
      echo "Missing value for $1" >&2
      exit 1
    fi
    image=$2
    parsed_option_args=2
    return 0
    ;;
  --exec)
    if (($# < 2)); then
      echo "Missing value for $1" >&2
      exit 1
    fi
    exec_command=$2
    parsed_option_args=2
    return 0
    ;;
  esac

  return 1
}

while (($# > 0)); do
  if parse_oal_option "$@"; then
    shift "$parsed_option_args"
  else
    break
  fi
done

if (($# < 1)); then
  echo "Usage: oal-notification-send [--exec <command>] [--app-name <app-name>] [-g <glyph>] [-u <low|normal|critical>] [--image <path-or-uri>] <headline> [description] [notify-send options]"
  exit 1
fi

headline=$1
shift

if (($# > 0)) && [[ $1 != -* ]]; then
  description=$1
  shift
fi

while (($# > 0)); do
  if parse_oal_option "$@"; then
    shift "$parsed_option_args"
  else
    args+=("$1")
    shift
  fi
done

# Tag as a user-action toast so it pops through DND.
args+=("-a" "$app_name" "-u" "$urgency")

# -g is still accepted, and no longer sends anything. It used to go out as a custom hint,
# oal-glyph, for the compositor shell to draw beside the text; that shell is not vendored here and
# nothing else has ever read the hint. Callers keep passing glyphs, so the flag stays rather than
# breaking two dozen call sites over a decoration.

# image-path, unlike the two hints above, is in the freedesktop specification, so this one is read.
if [[ -n $image ]]; then
  args+=("--hint=string:image-path:$image")
fi

set -- "$headline"
[[ -n $description ]] && set -- "$@" "$description"

if [[ -z $exec_command ]]; then
  notify-send "${args[@]}" "$@"
  exit 0
fi

# A click has to reach a command.
#
# This used to be a third custom hint, oal-exec, and the comment here explained that the compositor
# shell ran the command itself from its own copy of the popup, and that a libnotify action would
# instead block this process until the click. The first half stopped being true the day that shell
# was left out of vendoring: nothing on this desktop reads oal-exec, so every "click to diagnose"
# notification the machine has ever sent has been a dead popup. The second half is still true, and
# is the reason the wait happens in a detached process rather than in the caller, which expects to
# get its shell back immediately.
#
# --action=default is the specification's name for "the body was clicked", so it draws no extra
# button; notify-send --wait prints the invoked key and exits when the popup is answered or expires.
if command -v setsid >/dev/null; then
  launch=(setsid --fork)
else
  launch=()
fi

OAL_NOTIFY_EXEC="$exec_command" "${launch[@]}" bash -c '
  key="$(notify-send --wait --action=default=Open "$@")" || exit 0
  [[ $key == default ]] || exit 0
  exec bash -c "$OAL_NOTIFY_EXEC"
#
# The redirections close every descriptor this process inherited, not just the standard three.
# `notify-send --wait` lives until the popup is answered, and a critical-urgency popup does not
# expire on its own -- so this waiter can outlive its caller by hours. Anything it still holds open
# is held open for that long too.
#
# That is not theoretical. `bats` reads its results through a pipe on fd 3; a test that sent one of
# these left the waiter holding the write end, so bats reported all 409 results and then parked
# forever waiting for an EOF that could not come. A run left overnight was still sitting there nine
# hours later, which is why `oal-dev-check` never returned and why a branch of finished work sat
# uncommitted.
' oal-notification-send "${args[@]}" "$@" </dev/null >/dev/null 2>&1 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
