#!/bin/bash

# oal:summary=Prompt for text input from a menu
# oal:group=menu
# oal:name=input
# oal:args=prompt [menu args...]
# oal:examples=oal menu input Reminder|oal-menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

menu_width=""

while (( $# > 0 )); do
  case "$1" in
    --width)
      shift
      if (( $# == 0 )); then
        echo "oal-menu-input: --width requires a value" >&2
        exit 1
      fi
      menu_width="$1"
      ;;
  esac
  shift
done

# The same backends as oal-menu-select, in the same order, so a prompt looks like the menu it came
# from: kdialog first because it works with a mouse, fuzzel when OAL_MENU_BACKEND=fuzzel asks for it.
# A free-text answer is not something a picker can return, so this cannot be a call to the picker.
#
# It used to send a JSON payload to a menu plugin over a compositor IPC that is not vendored here,
# so it exited 127 and every caller waiting for an answer got none.
answer=""
if [[ ${OAL_MENU_BACKEND:-} != fuzzel ]] && command -v kdialog >/dev/null; then
  answer=$(kdialog --title "Agentarchy" --inputbox "$prompt" 2>/dev/null) || exit 1
elif command -v fuzzel >/dev/null; then
  args=(--dmenu --prompt-only "$prompt> " --no-exit-on-keyboard-focus-loss)
  config="${XDG_STATE_HOME:-$HOME/.local/state}/oal/current/theme/fuzzel.ini"
  [[ -r $config ]] && args+=(--config "$config")
  [[ -n $menu_width ]] && args+=(--width "$menu_width")
  answer=$(fuzzel "${args[@]}" </dev/null 2>/dev/null) || exit 1
else
  echo "oal-menu-input: neither kdialog nor fuzzel is installed" >&2
  exit 1
fi

[[ -n $answer ]] || exit 1
printf '%s\n' "$answer"
