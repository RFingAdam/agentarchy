#!/bin/bash

# oal:summary=Remove the GeForce NOW Flatpak app and its data.
# oal:group=remove
# oal:name=gaming geforce-now

set -e

if oal-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
