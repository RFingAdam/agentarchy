#!/bin/bash

# oal:summary=Send the low battery warning notification and run battery-low hooks.
# oal:args=<percentage>
# oal:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: oal-battery-low <percentage>" >&2
  exit 1
fi

level=$1

oal-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
oal-hook battery-low "$level"
