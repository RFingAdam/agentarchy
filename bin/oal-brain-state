#!/bin/bash

# oal:summary=Report what this machine is currently doing, for a brain to read
# oal:examples=oal-brain-state

# The read-only half of the verb set. Plain key: value lines rather than JSON: the consumer is a
# language model, both are equally parseable to it, and this one is equally readable to the person
# debugging why it answered what it did.
set -uo pipefail
bin_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export OAL_PATH="${OAL_PATH:-$(dirname "$bin_dir")}"

say() { printf '%s: %s\n' "$1" "${2:-unknown}"; }

# uname -n, not hostname: inetutils is not part of a base Arch install, so `hostname` is frequently
# absent and this line reported the machine as "unknown" to every brain that asked.
say host "$(uname -n 2>/dev/null)"
say uptime "$(uptime -p 2>/dev/null | sed 's/^up //')"
# oal-theme-current, not a basename of the state path. Upstream keeps current/theme as a symlink
# into themes/<name>, so resolving it gave the name; on this tree it is a directory of rendered
# files, so `readlink -f` returned the path unchanged and every brain was told the theme was called
# "theme". A fact that is confidently wrong is worse than one that is missing, and this one is
# injected into every grounded question.
say theme "$(oal-theme-current 2>/dev/null)"
say layout "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/oal/layout" 2>/dev/null)"
say agent-posture "$(oal-agent-profile 2>/dev/null)"
say session "${XDG_SESSION_TYPE:-none}"

# Only when there is one. A desktop reporting "battery: unknown" on every line of every answer
# teaches the reader to skim, and then they skim the line that mattered.
for bat in /sys/class/power_supply/BAT*; do
  [[ -r $bat/capacity ]] || continue
  say battery "$(cat "$bat/capacity")% ($(cat "$bat/status" 2>/dev/null))"
  break
done
