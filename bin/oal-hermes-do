#!/bin/bash

# oal:summary=Act on the Hermes fleet: claim, complete, approve, request changes, gateways
# oal:args=<action> [target] [reason...]
# oal:examples=oal-hermes-do claim t_f15b66ee | oal-hermes-do promote t_f15b66ee "looks right"

# The write half of the Hermes surface. Reading a board tells you what wants you; this is doing
# something about it without leaving the desktop.
#
# Three rules, because these land on real infrastructure and a panel click is a cheap gesture:
#
#   Nothing acts without confirmation. --yes for scripts, a picker for a person.
#   The confirmation names the task, not the id. "t_f15b66ee" is not something anyone recognises.
#   The result is said out loud, because a silent success and a silent failure look identical.
#
# These are deliberately not brain verbs. An agent cannot reach them: default/brain/VERBS is the
# whole surface a backend can drive, and completing your tasks is not on it. A person does this.
set -uo pipefail

bin_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export OAL_PATH="${OAL_PATH:-$(dirname "$bin_dir")}"
export PATH="$OAL_PATH/bin:$PATH"

die() { echo "oal-hermes-do: $*" >&2; exit 1; }
notify() { command -v oal-notification-send >/dev/null && oal-notification-send "$@" >/dev/null 2>&1 || true; }

assume_yes=0
args=()
for a in "$@"; do
  [[ $a == --yes ]] && { assume_yes=1; continue; }
  args+=("$a")
done
set -- "${args[@]}"

action="${1:-}"
[[ -n $action ]] || die "which action? claim, complete, promote, changes, gateway-start, gateway-stop, gateway-restart"
shift

# What a task actually is, so a confirmation can name it. One call, and it doubles as proof the id
# exists before anything is attempted.
task_title() {
  oal-hermes kanban show "$1" --json 2>/dev/null |
    jq -r '(.title // .task.title // empty)' 2>/dev/null | head -1
}

# Ask, unless told not to. The picker is used when there is one so this works identically from the
# menu and from a terminal; without either, refusing beats guessing.
confirm() {
  local question="$1"
  (( assume_yes )) && return 0
  # A picker only counts if it has a backend. Checking oal-menu-select alone sent this down the
  # graphical path on a machine with neither kdialog nor fuzzel, where the failure read as a crash
  # rather than as "nothing was done".
  if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] &&
     command -v oal-menu-select >/dev/null &&
     { command -v kdialog >/dev/null || command -v fuzzel >/dev/null; }; then
    local answer
    answer="$(printf '%s\n' $'\tno\tleave it alone' $'\tyes\tdo it' | oal-menu-select "$question")" || return 1
    [[ ${answer%%$'\t'*} == yes ]]
    return
  fi
  if [[ -t 0 ]]; then
    local reply
    read -r -p "$question [y/N] " reply
    [[ ${reply,,} == y* ]]
    return
  fi
  die "nothing done: no way to ask you here. Pass --yes if you mean it."
}

run_and_report() {
  local what="$1"; shift
  local out rc=0
  out="$("$@" 2>&1)" || rc=$?
  if (( rc == 0 )); then
    notify "$what" "done"
    printf '%s\n' "${out:-done}"
  else
    notify "$what failed" "$(printf '%s' "$out" | tail -n 1)"
    printf '%s\n' "$out" >&2
  fi
  return "$rc"
}

case "$action" in
  claim|complete|promote|changes)
    task="${1:-}"; shift || true
    [[ -n $task ]] || die "$action needs a task id"
    title="$(task_title "$task")"
    [[ -n $title ]] || die "no task '$task' on this Hermes"
    reason="$*"
    case "$action" in
      claim)
        confirm "Claim: $title" || exit 0
        run_and_report "Claimed $task" oal-hermes kanban claim "$task"
        ;;
      complete)
        confirm "Complete: $title" || exit 0
        if [[ -n $reason ]]; then
          run_and_report "Completed $task" oal-hermes kanban complete "$task" --summary "$reason"
        else
          run_and_report "Completed $task" oal-hermes kanban complete "$task"
        fi
        ;;
      promote)
        # The approval. It moves work forward on somebody's board, so it asks like the rest.
        confirm "Approve and promote: $title" || exit 0
        if [[ -n $reason ]]; then
          run_and_report "Promoted $task" oal-hermes kanban promote "$task" "$reason"
        else
          run_and_report "Promoted $task" oal-hermes kanban promote "$task"
        fi
        ;;
      changes)
        [[ -n $reason ]] || die "request-changes needs a reason: what has to change before re-review"
        confirm "Request changes on: $title" || exit 0
        run_and_report "Changes requested on $task" oal-hermes kanban request-changes "$task" "$reason"
        ;;
    esac
    ;;
  gateway-start|gateway-stop|gateway-restart)
    # Hermes starts and stops the *current* profile; `gateway start <name>` is not a thing it takes.
    # Switching profile to reach another one is `hermes profile use`, which sets a sticky default --
    # a lasting change to somebody's environment, and not something to do behind a menu entry.
    verb="${action#gateway-}"
    current="$(oal-hermes gateway list 2>/dev/null | sed -n 's/.*✓ \([a-z0-9-]*\) (current).*/\1/p' | head -1)"
    confirm "Gateway $verb: ${current:-current profile}" || exit 0
    run_and_report "Gateway $verb" oal-hermes gateway "$verb"
    ;;
  *) die "unknown action '$action'. Try claim, complete, promote, changes, gateway-start, gateway-stop, gateway-restart" ;;
esac
