#!/usr/bin/env bash
# oal:summary=One line of agent state for the shell prompt
# oal:args=[--refresh]
# oal:examples=oal-agent-hud | oal-agent-hud --refresh
#
# Prints something like:  opus-5  scoped  9 mcp  38%
#
# This runs on every prompt, so the rule that matters more than what it shows is what it must never
# do: no network, no python, no agent CLI. It reads one small JSON file and stops. `--refresh` is the
# side that does the slow work, and a systemd --user timer owns it (install/agent/).
#
# When the state file is missing, unreadable or stale, this prints nothing and exits 0. A prompt is
# not the place to report that a cache is cold.
set -uo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/oal"
state="$state_dir/agent-hud.json"
# Older than this and the numbers are lies. The timer refreshes well inside it.
max_age=900

# --json is for the panel widget, which wants fields rather than a line. The prompt keeps using the
# line, so both surfaces are fed by one cache and cannot disagree about what the agent is doing.
if [[ ${1:-} == --json ]]; then
  [[ -r $state ]] || { echo '{}'; exit 0; }
  read -r cached <"$state" 2>/dev/null || { echo '{}'; exit 0; }
  [[ $cached == \{*\} ]] || { echo '{}'; exit 0; }
  posture=scoped
  [[ -r $state_dir/agent-profile ]] && read -r posture <"$state_dir/agent-profile" 2>/dev/null
  # Spliced rather than parsed: this is a format we write ourselves a few lines above, and reaching
  # for jq here would put a dependency on a path that has none.
  printf '%s,"profile":"%s"}\n' "${cached%\}}" "${posture//[^a-z]/}"
  exit 0
fi

profile_now() {
  local f="$state_dir/agent-profile"
  [[ -r $f ]] && tr -d '[:space:]' <"$f" || echo scoped
}

if [[ ${1:-} == --refresh ]]; then
  mkdir -p -- "$state_dir"
  model="" pct=""
  if command -v oal-agent-usage-claude >/dev/null; then
    # --limits-only is the cheap path; it still may touch the network, which is exactly why the
    # prompt never calls this branch.
    usage="$(timeout 20 oal-agent-usage-claude --limits-only 2>/dev/null || true)"
    if [[ -n $usage ]] && command -v jq >/dev/null; then
      model="$(jq -r '(.model // .default_model // empty) | tostring' <<<"$usage" 2>/dev/null || true)"
      pct="$(jq -r '(.limits.five_hour.utilization // .utilization // empty) | tostring' <<<"$usage" 2>/dev/null || true)"
    fi
  fi
  mcp=0
  command -v oal-mcp-status >/dev/null && mcp="$(oal-mcp-status --count 2>/dev/null || echo 0)"

  # Whether a brain is configured, and whether it answers. Both are decided here rather than on the
  # prompt: reaching a brain can mean a network round trip, and the read path below is builtins only.
  brain="" brain_up=0
  if command -v oal-brain-backend >/dev/null; then
    brain="$(oal-brain-backend 2>/dev/null || true)"
    if [[ -n $brain ]] && timeout 10 oal-brain-status >/dev/null 2>&1; then brain_up=1; fi
  fi

  # What the Hermes this machine talks to is doing. Free queries -- boards and gateway state are
  # local to the Hermes host, not model calls -- but they are ssh round trips, so they belong here on
  # the timer rather than on the panel's repaint.
  hermes_up=0 hermes_attention=0
  if command -v oal-hermes-status >/dev/null; then
    brief="$(timeout 45 oal-hermes-status --brief 2>/dev/null)"
    [[ $brief =~ up=([0-9]+) ]] && hermes_up="${BASH_REMATCH[1]}"
    [[ $brief =~ attention=([0-9]+) ]] && hermes_attention="${BASH_REMATCH[1]}"
  fi

  # The timestamp goes in the file so the read path can judge staleness without a stat(1).
  printf -v now '%(%s)T' -1
  tmp="$(mktemp)"
  printf '{"ts":%s,"model":"%s","mcp":%s,"pct":"%s","brain":"%s","brain_up":%s,"gateways":%s,"attention":%s}\n' \
    "$now" "${model:-}" "${mcp:-0}" "${pct:-}" "${brain:-}" "$brain_up" \
    "${hermes_up:-0}" "${hermes_attention:-0}" >"$tmp"
  mv -- "$tmp" "$state"
  exit 0
fi

# --- the hot path: this runs on every prompt ------------------------------------------------------
#
# No external commands from here down. Not one. The first version used sed to pull four fields and
# stat to check the age, and cost 39 ms a prompt -- six forks for a line of text, on every keystroke
# that redraws. Builtins only brings it under a millisecond, and the whole point of caching to a file
# is lost if reading the file is itself expensive.

[[ -r $state ]] || exit 0
read -r body <"$state" || exit 0

# Bash regex over the whole record, once, rather than a parser per field.
[[ $body =~ \"ts\":([0-9]+) ]] || exit 0
printf -v now '%(%s)T' -1
(( now - BASH_REMATCH[1] < max_age )) || exit 0

model=""; mcp=""; pct=""
[[ $body =~ \"model\":\"([^\"]*)\" ]] && model="${BASH_REMATCH[1]}"
[[ $body =~ \"mcp\":([0-9]+) ]] && mcp="${BASH_REMATCH[1]}"
[[ $body =~ \"pct\":\"([^\"]*)\" ]] && pct="${BASH_REMATCH[1]}"

profile=scoped
[[ -r $state_dir/agent-profile ]] && read -r profile <"$state_dir/agent-profile"

line="${model#claude-}"
[[ -n $line ]] && line+="  "
line+="$profile"
[[ -n $mcp && $mcp != 0 ]] && line+="  $mcp mcp"
[[ -n $pct ]] && line+="  ${pct%%.*}%"

# Only when one is configured, so a prompt on a machine with no brain is exactly what it was before.
# A configured brain that is not answering says so: showing a dead one as live is worse than the two
# extra characters it costs to be honest.
# Tasks wanting a person, on the prompt as well as the panel. Only when there are some: a prompt
# that says "0 waiting" on every line teaches people to stop reading it.
attention=0
[[ $body =~ \"attention\":([0-9]+) ]] && attention="${BASH_REMATCH[1]}"
(( attention )) && line+="  ${attention} waiting"

brain=""; brain_up=0
[[ $body =~ \"brain\":\"([^\"]*)\" ]] && brain="${BASH_REMATCH[1]}"
[[ $body =~ \"brain_up\":([0-9]+) ]] && brain_up="${BASH_REMATCH[1]}"
if [[ -n $brain ]]; then
  line+="  brain $brain"
  (( brain_up )) || line+=" (down)"
fi

printf '%s\n' "$line"
