#!/bin/bash

# oal:summary=Set the Agentarchy package channel.
# oal:args=<stable|rc|edge|dev>
# oal:requires-sudo=true

set -euo pipefail

usage() { echo "Usage: oal-channel-set [stable|rc|edge|dev]"; }
fail() { echo "Error: $*" >&2; exit 1; }

confirm_dev() {
  cat <<'WARNING'

The dev channel links Agentarchy directly to a checkout of the source in ~/oal.
It's exclusively intended for developers working on Agentarchy itself.

WARNING

  gum confirm --default=false "Switch to dev channel?"
}

validate_dev_checkout() {
  local checkout="$1"

  if [[ -e $checkout && ! -d $checkout/.git ]]; then
    fail "$checkout already exists and is not a git checkout."
  fi

  if [[ -d $checkout/.git && ( ! -d $checkout/bin || ! -d $checkout/default || ! -d $checkout/shell ) ]]; then
    fail "$checkout is a git checkout, but it does not look like Agentarchy."
  fi
}

link_dev_checkout() {
  local checkout="$1"
  [[ -d $checkout/.git ]] || git clone https://github.com/RFingAdam/agentarchy.git "$checkout"

  oal-dev-link "$checkout" --no-reboot
}

(( $# > 0 )) || { usage; exit 1; }

dev_checkout=""
channel="$1"
leaving_dev=0

case "$channel" in
  stable)
    pacman_channel=stable
    packages=(oal oal-settings)
    ;;
  rc)
    pacman_channel=rc
    packages=(oal oal-settings)
    ;;
  edge)
    pacman_channel=edge
    packages=(oal-dev oal-settings-dev)
    ;;
  dev)
    confirm_dev || { echo "Cancelled."; exit 0; }
    dev_checkout="$HOME/oal"
    validate_dev_checkout "$dev_checkout"
    pacman_channel=edge
    packages=(oal-dev oal-settings-dev)
    ;;
  *)
    echo "Unknown channel: $channel" >&2
    usage >&2
    exit 1
    ;;
esac

if [[ -z $dev_checkout && $OAL_PATH != "/usr/share/agentarchy" ]]; then
  leaving_dev=1
fi

if [[ -n $dev_checkout ]]; then
  link_dev_checkout "$dev_checkout"
  export OAL_PATH="$dev_checkout"
  export PATH="$OAL_PATH/bin:$PATH"
  oal-state set reboot-required
fi

oal-refresh-pacman "$pacman_channel"
# --ask 4 accepts oal <-> oal-dev replacement prompts without file overwrites.
sudo env OAL_UPDATE_PACMAN=1 pacman -S --needed --noconfirm --ask 4 "${packages[@]}"

if [[ -z $dev_checkout ]]; then
  oal-dev-unlink --no-reboot
  export OAL_PATH=/usr/share/agentarchy

  if (( leaving_dev )); then
    oal-state set reboot-required
  fi
fi

oal-update -y
