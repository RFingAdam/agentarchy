#!/bin/bash

# oal:summary=Run a command while holding the Agentarchy update lock
# oal:args=<held|run> [command] [args...]
# oal:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/oal-update.lock"

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${OAL_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$OAL_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$OAL_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$OAL_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: oal-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {OAL_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$OAL_UPDATE_LOCK_FD"; then
      echo "An Agentarchy update is already running."
      exit 1
    fi

    export OAL_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: oal-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac
