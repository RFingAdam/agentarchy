#!/bin/bash

# oal:summary=Report what is wrong with this machine, for a person or an agent
# oal:args=[--json] [--quiet]
# oal:examples=oal-doctor | oal-doctor --json | oal-doctor --json | jq .checks

# The machine describing itself. This exists because "are there any OS issues?" was a question the
# agent layer could not answer: oal-brain-ask handed the words to a model and the model, having no
# way to look, answered from memory. Facts have to come from somewhere before phrasing them is worth
# anything.
#
# Two rules, and they are the same rule the tool-call guard follows:
#
#   A check that could not run reports `unknown`, never `ok`. Reporting a clean bill of health for a
#   check that never executed is the failure mode that makes the whole report worthless, because it
#   is indistinguishable from a real pass and nobody looks twice at a pass.
#
#   Nothing here blocks. Every external command is under a timeout. This is read by a shell prompt's
#   consumers, a notification path and a model, and none of them can afford to wait on a mirror.
set -uo pipefail

bin_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export OAL_PATH="${OAL_PATH:-$(dirname "$bin_dir")}"
export PATH="$OAL_PATH/bin:$PATH"

as_json=0
quiet=0
for arg in "$@"; do
  case "$arg" in
    --json)  as_json=1 ;;
    --quiet|-q) quiet=1 ;;
    -h|--help) sed -n '3,5p' "$0" | sed 's/^# oal://'; exit 0 ;;
    *) echo "oal-doctor: unknown option: $arg" >&2; exit 64 ;;
  esac
done

# Bounds every journal read. High enough that a real problem is visible, low enough that the report
# stays under a second on a machine that has been up for weeks.
readonly JOURNAL_CAP=1000

declare -a IDS SEVS SUMS DETS

# record <id> <severity> <summary> [detail]
#   ok       nothing to do
#   warn     worth knowing, not urgent
#   problem  something is broken now
#   unknown  the check could not run, which is not the same as ok
record() {
  IDS+=("$1"); SEVS+=("$2"); SUMS+=("$3"); DETS+=("${4:-}")
}

run() { timeout "${1}" "${@:2}" 2>/dev/null; }

# --- is the system itself happy --------------------------------------------------------------------

check_boot() {
  local state
  state="$(run 5 systemctl is-system-running)" || true
  case "$state" in
    running)   record boot ok "systemd reports the system as running" ;;
    degraded)  record boot problem "systemd reports the system as degraded" "at least one unit failed; see the failed-units check" ;;
    starting|initializing) record boot ok "still starting up ($state)" ;;
    "")        record boot unknown "could not ask systemd for the system state" ;;
    *)         record boot warn "systemd reports: $state" ;;
  esac
}

check_failed_units() {
  local sys usr all n
  sys="$(run 10 systemctl --failed --no-legend --plain --no-pager)" || true
  usr="$(run 10 systemctl --user --failed --no-legend --plain --no-pager)" || true
  all="$(printf '%s\n%s\n' "$sys" "$usr" | awk 'NF {print $1}' | sort -u)"
  n="$(printf '%s' "$all" | grep -c . || true)"
  if (( n == 0 )); then
    record failed-units ok "no failed units"
  else
    record failed-units problem "$n failed unit$( ((n>1)) && echo s)" "$all"
  fi
}

check_journal_errors() {
  local out n
  # --since boot rather than a window: "since you turned it on" is the span a person means.
  # -n bounds it: journalctl seeks from the end, so this stays fast on a machine that has been up
  # for a week. Unbounded, this one check was four of the report's four and a half seconds.
  out="$(run 15 journalctl -p err -b --no-pager -q -n "$JOURNAL_CAP" -o short-monotonic)" || {
    record journal unknown "the journal could not be read (permission, or no persistent storage)"
    return
  }
  n="$(printf '%s' "$out" | grep -c . || true)"
  local label="$n"
  (( n >= JOURNAL_CAP )) && label="$JOURNAL_CAP+"
  if (( n == 0 )); then
    record journal ok "no errors logged since boot"
  else
    # The last few, because the newest error is usually the one being asked about.
    record journal warn "$label error line$( ((n>1)) && echo s) logged since boot" "$(printf '%s' "$out" | tail -n 5)"
  fi
}

check_oom() {
  local out n
  # -k, kernel only. `-g` has to filter the whole boot whatever -n says, and restricting the
  # transport first took this from 1.37s to 0.24s. The kernel is also the authority here: systemd's
  # "Failed with result 'oom-kill'" is a report of what the kernel already logged.
  # Readability is probed separately, and it has to be. `journalctl -g` exits 1 when nothing
  # matches, which is the overwhelmingly common case here -- so treating a non-zero exit as "could
  # not be read" reported a healthy machine as unreadable. That is the report's own rule inverted:
  # claiming ignorance where the honest answer was available and good.
  if ! run 5 journalctl -k -b -n 1 -q >/dev/null 2>&1; then
    record oom unknown "the kernel journal could not be read"
    return
  fi
  out="$(run 15 journalctl -k -b --no-pager -q -g 'oom-kill:|Out of memory' 2>/dev/null)" || out=""
  # One kill writes several lines. Count the verdict line, not the narration around it.
  n="$(printf '%s' "$out" | grep -c 'oom-kill:' || true)"
  if (( n == 0 )); then
    record oom ok "nothing has been killed for memory since boot"
  else
    record oom problem "the kernel killed something for memory $n time$( ((n>1)) && echo s)" "$(printf '%s' "$out" | grep 'oom-kill:' | tail -n 3 | sed 's/.*task=/killed: /; s/,pid=.*//')"
  fi
}

# --- resources -------------------------------------------------------------------------------------

check_disk() {
  local worst=0 worst_line="" pct mount out="" ro_mounts=""
  # Read-only filesystems are full by definition -- a mounted ISO, a squashfs, an install stick --
  # and reporting one as a full disk is a false alarm, which is the kind that teaches people to skim
  # past the real one.
  while read -r _ mp _ opts _; do
    [[ ,$opts, == *,ro,* ]] && ro_mounts+="$mp"$'\n'
  done </proc/mounts 2>/dev/null

  while read -r _ _ _ _ pct mount; do
    pct="${pct%\%}"
    [[ $pct =~ ^[0-9]+$ ]] || continue
    grep -qxF "$mount" <<<"$ro_mounts" && continue
    out+="$mount ${pct}% full"$'\n'
    if (( pct > worst )); then worst="$pct"; worst_line="$mount is ${pct}% full"; fi
  done < <(run 10 df -P -x tmpfs -x devtmpfs -x squashfs -x overlay -x iso9660 -x udf -x efivarfs -x vfat 2>/dev/null | tail -n +2)

  if [[ -z $worst_line ]]; then
    record disk unknown "could not read filesystem usage"
  elif (( worst >= 95 )); then
    record disk problem "$worst_line" "${out%$'\n'}"
  elif (( worst >= 85 )); then
    record disk warn "$worst_line" "${out%$'\n'}"
  else
    record disk ok "$worst_line"
  fi
}

check_thermal() {
  local f t max=0 name="" found=0
  for f in /sys/class/thermal/thermal_zone*/temp; do
    [[ -r $f ]] || continue
    read -r t <"$f" 2>/dev/null || continue
    [[ $t =~ ^-?[0-9]+$ ]] || continue
    found=1
    (( t > max )) && { max="$t"; name="$(cat "${f%/temp}/type" 2>/dev/null || echo zone)"; }
  done
  if (( found == 0 )); then
    record thermal unknown "no thermal sensors are exposed (normal in a virtual machine)"
    return
  fi
  local c=$(( max / 1000 ))
  if (( c >= 95 )); then
    record thermal problem "$name is at ${c}C"
  elif (( c >= 85 )); then
    record thermal warn "$name is at ${c}C"
  else
    record thermal ok "hottest sensor $name at ${c}C"
  fi
}

# --- packages --------------------------------------------------------------------------------------

check_updates() {
  command -v pacman >/dev/null || { record updates unknown "pacman is not on this machine"; return; }
  # `pacman -Qu` against the sync database already on disk, not `checkupdates`, which downloads a
  # fresh one. A health report that reaches for the network is a health report that hangs on the
  # train, and the honest answer -- "as of your last sync" -- is the one worth giving instantly.
  local out n age="" sync=/var/lib/pacman/sync
  out="$(run 20 pacman -Qu)" || true
  n="$(printf '%s' "$out" | grep -c . || true)"

  if [[ -d $sync ]]; then
    local mtime now days
    mtime="$(stat -c %Y "$sync" 2>/dev/null)" || mtime=""
    if [[ -n $mtime ]]; then
      printf -v now '%(%s)T' -1
      days=$(( (now - mtime) / 86400 ))
      (( days >= 7 )) && age=" (package lists last synced $days days ago)"
    fi
  fi

  if (( n == 0 )); then
    record updates ok "no pending package updates$age"
  else
    record updates warn "$n package update$( ((n>1)) && echo s) pending$age" "$(printf '%s' "$out" | head -n 10)"
  fi
}

check_orphans() {
  command -v pacman >/dev/null || { record orphans unknown "pacman is not on this machine"; return; }
  local out n
  out="$(run 20 pacman -Qtdq)" || true
  n="$(printf '%s' "$out" | grep -c . || true)"
  if (( n == 0 )); then
    record orphans ok "no orphaned packages"
  else
    record orphans warn "$n orphaned package$( ((n>1)) && echo s)" "$(printf '%s' "$out" | head -n 10)"
  fi
}

check_pacnew() {
  command -v pacman >/dev/null || { record pacnew unknown "pacman is not on this machine"; return; }
  local out n
  out="$(run 20 find /etc -name '*.pacnew' -o -name '*.pacsave')" || true
  n="$(printf '%s' "$out" | grep -c . || true)"
  if (( n == 0 )); then
    record pacnew ok "no unmerged .pacnew files"
  else
    record pacnew warn "$n config file$( ((n>1)) && echo s) left unmerged by an update" "$out"
  fi
}

# --- the outside world ------------------------------------------------------------------------------

check_network() {
  local route
  route="$(run 5 ip route show default)" || true
  if [[ -z $route ]]; then
    record network problem "no default route: this machine has no way out"
    return
  fi
  # Resolution rather than ping: ICMP is blocked often enough that a failed ping is a bad signal,
  # and DNS is what actually breaks.
  if run 8 getent hosts archlinux.org >/dev/null; then
    record network ok "connected, and names resolve"
  else
    record network warn "there is a default route but names do not resolve" "${route%%$'\n'*}"
  fi
}

check_gpu() {
  # sysfs, not lspci. bin/oal-hw-nvidia already established why: lspci reads PCI config space and
  # resumes runtime-suspended GPUs, so asking a laptop what graphics it has would wake the discrete
  # card and cost battery to answer a question nobody urgently needed. It is also 0.4s faster,
  # because lspci looks every id up in a names database.
  local devices="${OAL_PCI_DEVICES_PATH:-/sys/bus/pci/devices}" device vendor driver
  local found=0 nvidia=0 nvidia_driver=""
  shopt -s nullglob
  for device in "$devices"/*; do
    [[ -r $device/class && -r $device/vendor ]] || continue
    [[ $(<"$device/class") == 0x03* ]] || continue
    found=1
    vendor="$(<"$device/vendor")"
    driver=""
    [[ -e $device/driver ]] && driver="$(basename "$(readlink -f "$device/driver")")"
    if [[ $vendor == 0x10de ]]; then
      nvidia=1
      nvidia_driver="$driver"
    fi
  done
  shopt -u nullglob

  if (( found == 0 )); then
    record gpu unknown "no display controller found in sysfs"
    return
  fi
  if (( nvidia == 0 )); then
    record gpu ok "graphics driver in use: ${driver:-none bound}"
    return
  fi
  case "$nvidia_driver" in
    nvidia)
      # Bound is not the same as working, and nvidia-smi is cheap.
      if command -v nvidia-smi >/dev/null && ! run 15 nvidia-smi -L >/dev/null; then
        record gpu problem "the NVIDIA driver is bound but nvidia-smi does not answer"
      else
        record gpu ok "NVIDIA card, nvidia driver bound"
      fi
      ;;
    nouveau) record gpu warn "NVIDIA card running on nouveau, not the NVIDIA driver" ;;
    "")      record gpu problem "an NVIDIA card is present with no driver bound to it" ;;
    *)       record gpu warn "NVIDIA card bound to an unexpected driver: $nvidia_driver" ;;
  esac
}

# --- the agent layer itself --------------------------------------------------------------------------

check_agent() {
  local posture engine="$OAL_PATH/default/guard/lib.sh"
  local hook="$OAL_PATH/agent/hooks/pretooluse-guard"
  posture="$(run 5 oal-agent-profile)" || true
  [[ -n $posture ]] || posture=unknown

  if [[ ! -r $engine ]]; then
    record guard problem "the tool-call policy engine is missing" "$engine"
  elif ! command -v claude >/dev/null; then
    # The engine is what enforces; a hook is one runtime's way of reaching it. With no runtime
    # installed there is nothing to wire, and reporting that as a fault would be a permanent red
    # light on a machine where nothing is wrong.
    record guard ok "policy engine present, posture $posture (no agent runtime installed to wire)"
  else
    local settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
    if [[ -r $settings ]] && command -v jq >/dev/null &&
       jq -e --arg g "$hook" '[.hooks.PreToolUse[]?.hooks[]?.command] | index($g)' "$settings" >/dev/null 2>&1; then
      record guard ok "tool calls are guarded, posture $posture"
    else
      record guard problem "Claude Code is installed but its tool calls are not routed through the guard" \
        "re-run: bash $OAL_PATH/install/agent/runtime.sh"
    fi
  fi

  backend="$(run 5 oal-brain-backend)" || true
  if [[ -z $backend ]]; then
    record brain warn "no brain backend is configured" "choose one: oal-brain-backend --list"
    return
  fi
  local adapter="$OAL_PATH/default/brain/adapters/$backend"
  [[ -x ${HOME:-}/.config/oal/brain/adapters/$backend ]] && adapter="$HOME/.config/oal/brain/adapters/$backend"
  if [[ ! -x $adapter ]]; then
    record brain problem "backend '$backend' is selected but has no adapter installed"
  elif run 20 "$adapter" probe </dev/null; then
    record brain ok "brain '$backend' answers"
  else
    record brain problem "brain '$backend' is configured but does not answer" "oal-brain-status says more"
  fi
}

# --- run them ------------------------------------------------------------------------------------------

check_boot
check_failed_units
check_journal_errors
check_oom
check_disk
check_thermal
check_updates
check_orphans
check_pacnew
check_network
check_gpu
check_agent

# --- verdict -------------------------------------------------------------------------------------------

worst=ok
for s in "${SEVS[@]}"; do
  case "$s" in
    problem) worst=problem ;;
    warn|unknown) [[ $worst == problem ]] || worst=warn ;;
  esac
done

if (( as_json )); then
  command -v jq >/dev/null || { echo '{"ok":false,"severity":"unknown","error":"jq is not installed"}'; exit 1; }
  for i in "${!IDS[@]}"; do
    jq -nc --arg id "${IDS[$i]}" --arg sev "${SEVS[$i]}" --arg sum "${SUMS[$i]}" --arg det "${DETS[$i]}" \
      '{id:$id, severity:$sev, summary:$sum} + (if $det == "" then {} else {detail:$det} end)'
  done | jq -sc --arg w "$worst" '{ok: ($w == "ok"), severity: $w, checks: .}'
elif (( quiet == 0 )); then
  for i in "${!IDS[@]}"; do
    printf '%-8s %-14s %s\n' "${SEVS[$i]}" "${IDS[$i]}" "${SUMS[$i]}"
    if [[ -n ${DETS[$i]} && ${SEVS[$i]} != ok ]]; then
      while IFS= read -r line; do
        [[ -n $line ]] && printf '%-8s %-14s   %s\n' "" "" "$line"
      done <<<"${DETS[$i]}"
    fi
  done
fi

case "$worst" in
  ok) exit 0 ;;
  warn) exit 1 ;;
  *) exit 2 ;;
esac
