#!/usr/bin/env bash
# oal:summary=Apply the default panel layout, once, on the first graphical login
# oal:hidden=true
#
# A layout can only be applied to a running Plasma, and nothing during an install is running Plasma:
# oal-apply-system may be in a chroot and oal-bootstrap.sh finishes before the first reboot. So the
# default arrives here, from config/autostart, on the first session that exists.
#
# It runs exactly once. After that the recorded layout is the user's, whether they kept the default
# or changed it, and a preset apply removes every panel -- rediscovering that at each login would
# throw away their arrangement daily.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/oal/layout"
[[ -e $state ]] && exit 0

# plasmashell has to be up to be scripted; the autostart entry fires alongside it, not after it.
for _ in $(seq 1 30); do
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "0" >/dev/null 2>&1 && break
  sleep 2
done

# Meta+Space opens the menu, Meta+A asks the machine a question. Bound here because
# kglobalshortcutsrc is only read by a running kglobalaccel, and because a shortcut the user has
# since changed must not be reset at every login -- same once-only reasoning as the layout above.
#
# The value is COMMA separated: shortcut,default,description, which is what KDE writes for its own
# bindings ("Show Desktop=Meta+D,Meta+D,Peek at Desktop"). Tabs were written here for months and
# kglobalaccel silently blanked the entry on every start, so Meta+Space had never once opened the
# menu -- the file looked right and the shortcut did not exist.
if command -v kwriteconfig6 >/dev/null; then
  kwriteconfig6 --file kglobalshortcutsrc --group services --group oal-menu.desktop \
    --key _launch "Meta+Space,none,Agentarchy Menu" 2>/dev/null || true
  kwriteconfig6 --file kglobalshortcutsrc --group services --group oal-ask.desktop \
    --key _launch "Meta+A,none,Ask Agentarchy" 2>/dev/null || true
fi

exec oal-layout-set "${OAL_LAYOUT:-ubuntu}"
