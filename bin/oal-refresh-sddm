#!/bin/bash

# oal:summary=Refresh the SDDM theme from default, optionally retinted for a theme
# oal:args=[theme-name]
# oal:examples=oal-refresh-sddm | oal-refresh-sddm tokyo-night
# oal:requires-sudo=true

# Derive OAL_PATH rather than requiring it. oal-bootstrap.sh calls this during an install, before
# /etc/profile.d/oal.sh has been sourced into any shell, so the exported value does not exist yet --
# and with `set -e` upstream a bare "$OAL_PATH" would end the install at a cp of "/default/sddm/oal".
# Exported because oal-theme-dir below reads it too.
bin_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export OAL_PATH="${OAL_PATH:-$(dirname "$bin_dir")}"

sudo rm -rf /usr/share/sddm/themes/oal
sudo cp -r "$OAL_PATH/default/sddm/oal" /usr/share/sddm/themes/oal

# The greeter runs as the sddm user before any session exists, so it cannot read the current theme
# the way every other consumer does. Its palette has to be written into the copy under /usr/share,
# which only root can do -- so this is the one place a theme change can reach the login screen, and
# why oal-theme-set-kde points here instead of trying. Called with no argument the installed theme
# keeps the theme.conf it shipped with, and Main.qml falls back to its literal colours.
theme="$(echo "${1:-}" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"
if [[ -n $theme ]]; then
  colors="$(oal-theme-dir "$theme")/colors.toml"
  if [[ -f $colors ]]; then
    oal-theme-render sddm.theme.conf --file "$colors" |
      sudo tee /usr/share/sddm/themes/oal/theme.conf >/dev/null
    echo "greeter palette: $theme"
  else
    echo "oal-refresh-sddm: theme '$theme' has no colors.toml; greeter left on its shipped palette" >&2
    exit 1
  fi
fi
