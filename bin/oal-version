#!/bin/bash

# oal:summary=Print the installed Agentarchy version

oal_path=${OAL_PATH:-/usr/share/agentarchy}
oal_path=${oal_path%/}

if [[ $oal_path != "/usr/share/agentarchy" ]]; then
  hash=$(git -C "$oal_path" rev-parse --short HEAD 2>/dev/null || true)

  if [[ -n $hash ]]; then
    echo "dev ($hash)"
  else
    echo "dev"
  fi

  exit 0
fi

# The package is named after the project, not after the oal-* command prefix. Upstream checks its
# stable/edge pair here; Agentarchy has neither, because the whole channel subsystem is inert until
# it is given real repositories to point at.
version=$(pacman -Q agentarchy 2>/dev/null | awk '{ print $2 }')

[[ -n $version ]] || exit 1

echo "$version"
