#!/usr/bin/env bash
# oal:summary=Register a catalog of MCP servers this distribution does not ship
# oal:args=<file.catalog> | --list | --forget <name>
# oal:examples=oal-mcp-import ~/work/rf-lab.catalog | oal-mcp-import --list
#
# The extension point. Agentarchy ships the mechanism and a small vendor-neutral catalog; anything
# private, licence-gated or hardware-bound belongs in a catalog of your own, and importing it must
# not require a change to this repository. Imported entries stay marked as such everywhere they
# appear, so it is always clear which servers the distribution vouches for.
set -euo pipefail
# shellcheck source=default/mcp/lib.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../default/mcp/lib.sh"

dir="$(oal_mcp_state)/imported"

case "${1:-}" in
  -h | --help) sed -n '2,4p' "$0"; exit 0 ;;
  --list)
    shopt -s nullglob
    for f in "$dir"/*.catalog; do printf '%-24s %s rows\n' "$(basename "$f" .catalog)" "$(grep -c '|' "$f")"; done
    exit 0 ;;
  --forget)
    name="${2:?--forget wants a catalog name}"
    [[ -f "$dir/$name.catalog" ]] || oal_mcp_die "no imported catalog called '$name'"
    rm -f -- "$dir/$name.catalog"
    echo "forgot $name (registered servers are untouched; use oal-mcp-remove for those)"
    exit 0 ;;
  "") sed -n '2,4p' "$0" >&2; exit 2 ;;
esac

file="$1"
[[ -f $file ]] || oal_mcp_die "no such file: $file"
name="$(basename "$file")"; name="${name%.catalog}"
[[ $name =~ ^[A-Za-z0-9_-]+$ ]] || oal_mcp_die "catalog name must be kebab or snake case: '$name'"
[[ $name != shipped ]] || oal_mcp_die "'shipped' is reserved for default/mcp/CATALOG"

# Validate every row before copying anything. A catalog that half-imports is worse than one that
# does not import at all.
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

rows=0
while IFS= read -r line; do
  # The whole line first, so the field count can be checked before any field is trusted. A row of the
  # wrong width splits without error and puts every value in its neighbour's slot -- a profile read
  # as a visibility, a description read as a profile -- and the catalog then silently does nothing.
  IFS='|' read -r -a parts <<<"$line"
  id="$(trim "${parts[0]:-}")"
  [[ -n $id && $id != \#* ]] || continue
  rows=$((rows + 1))

  (( ${#parts[@]} == 7 )) ||
    oal_mcp_die "$file: '$id' has ${#parts[@]} fields, expected 7 (id|kind|package|args|visibility|profiles|description)"

  case "$(trim "${parts[1]}")" in
    uvx | npx) ;;
    # Deliberately not `oal`. That kind runs a bare command from PATH, and it exists for the one
    # server this repository ships. Honouring it here would make any imported catalog a way to
    # register an arbitrary local command as an MCP server.
    oal) oal_mcp_die "$file: '$id' uses kind 'oal', which is reserved for servers this distribution ships" ;;
    *) oal_mcp_die "$file: '$id' has kind '$(trim "${parts[1]}")' (expected uvx or npx)" ;;
  esac
  [[ -n $(trim "${parts[2]}") ]] || oal_mcp_die "$file: '$id' has no package"
  [[ $(trim "${parts[4]}") =~ ^(public|private|hardware|commercial)$ ]] ||
    oal_mcp_die "$file: '$id' has visibility '$(trim "${parts[4]}")' (public, private, hardware or commercial)"
  [[ -n $(trim "${parts[5]}") ]] || oal_mcp_die "$file: '$id' names no profile"
  [[ -n $(trim "${parts[6]}") ]] || oal_mcp_die "$file: '$id' has no description"
done < <(grep -v '^[[:space:]]*#' "$file" | grep '|')
(( rows )) || oal_mcp_die "$file: no catalog rows found"

mkdir -p -- "$dir"
cp -- "$file" "$dir/$name.catalog"
echo "imported $name ($rows servers). Nothing installed: run oal-mcp-install or oal-mcp-list --profile <name>"
