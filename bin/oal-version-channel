#!/bin/bash

# oal:summary=Print the active Agentarchy mirror and package channel

if grep -q "https://stable-mirror.agentarchy.invalid/" /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -q "https://rc-mirror.agentarchy.invalid/" /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -q "https://mirror.agentarchy.invalid/" /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

if grep -q "https://pkgs.agentarchy.invalid/stable/" /etc/pacman.conf; then
  pkgs="stable"
elif grep -q "https://pkgs.agentarchy.invalid/edge/" /etc/pacman.conf; then
  pkgs="edge"
else
  pkgs="unknown"
fi

if [[ $mirror == $pkgs ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi
