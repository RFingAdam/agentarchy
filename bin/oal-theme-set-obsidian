#!/bin/bash

# oal:summary=Sync Agentarchy theme to all Obsidian vaults
# oal:hidden=true

CURRENT_THEME_DIR="$HOME/.local/state/oal/current/theme"

[[ -f $CURRENT_THEME_DIR/obsidian.css ]] || exit 0

jq -r '.vaults | values[].path' ~/.config/obsidian/obsidian.json 2>/dev/null | while read -r vault_path; do
  [[ -d $vault_path/.obsidian ]] || continue

  theme_dir="$vault_path/.obsidian/themes/Agentarchy"
  mkdir -p "$theme_dir"

  [[ -f $theme_dir/manifest.json ]] || cat >"$theme_dir/manifest.json" <<'EOF'
{
  "name": "Agentarchy",
  "version": "1.0.0",
  "minAppVersion": "0.16.0",
  "description": "Automatically syncs with your current Agentarchy system theme colors and fonts",
  "author": "Agentarchy",
  "authorUrl": "https://github.com/RFingAdam/agentarchy"
}
EOF

  cp "$CURRENT_THEME_DIR/obsidian.css" "$theme_dir/theme.css"
done
