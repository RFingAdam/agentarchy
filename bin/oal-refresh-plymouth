#!/bin/bash

# oal:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Agentarchy default and rebuild it.
# oal:requires-sudo=true

sudo cp -r "$OAL_PATH/default/plymouth/." /usr/share/plymouth/themes/oal/
sudo plymouth-set-default-theme oal

if oal-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
