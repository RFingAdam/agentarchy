#!/bin/bash

# oal:summary=Log out after closing application windows
# oal:examples=oal logout | oal system logout
# oal:aliases=oal logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

oal-osd -i logout -m "Logging out" -d 5000

# Now close all windows
oal-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
