#!/usr/bin/env bash
# oal:summary=Run every local quality gate (what CI runs)
# Eight gates, all of which must print PASS:
#   1. shellcheck         native scripts under bin/ and install/ (vendored ones are INFO only)
#   2. bats               test/unit
#   3. branding           the upstream project name outside its allowlist (content and file names)
#   4. notice             every themes/*/backgrounds file is listed in NOTICE
#   5. gitleaks           secrets in the committed history
#   6. gitleaks-worktree  secrets in files that are not committed yet (staged copy, see that script)
#   7. vendor-drift       the vendored tree still matches upstream/PIN + upstream/patches
#   8. dangling           no shipped desktop entry, unit, notification click or alias names a
#                         command this tree does not have
set -euo pipefail
export LC_ALL=C
# shellcheck source=bin/oal-dev-lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/oal-dev-lib.sh"
root="$(oal_dev_root)" || exit 1; cd "$root"
fail=0
gate() { local name="$1"; shift; if "$@"; then echo "PASS $name"; else echo "FAIL $name"; fail=1; fi; }

# Native shell scripts = scripts under bin/, install/ and test/vm/, plus the root-level bootstrap,
# that are not vendored. Vendored scripts are upstream's responsibility and must never be
# hand-edited, so they are reported (INFO) but never gate the build. test/fixtures is deliberately
# absent: those files are inert test data. PKGBUILD is bash but not a script -- makepkg supplies
# srcdir/pkgdir/startdir, so shellcheck can only report false positives about them.
mapfile -t all_scripts < <({ find bin install test/vm -type f -exec grep -lE '^#!.*(ba)?sh' {} + 2>/dev/null; ls oal-bootstrap.sh 2>/dev/null; } | sort -u)
mapfile -t native < <(comm -23 <(printf '%s\n' "${all_scripts[@]}") <(sort upstream/VENDORED-FILES.txt 2>/dev/null))
mapfile -t vendored < <(comm -12 <(printf '%s\n' "${all_scripts[@]}") <(sort upstream/VENDORED-FILES.txt 2>/dev/null))
gate shellcheck bash -c '[[ $# -eq 0 ]] || shellcheck -S warning -x "$@"' _ "${native[@]}"
if [[ ${#vendored[@]} -gt 0 ]]; then
  n="$(shellcheck -S warning -f gcc "${vendored[@]}" 2>/dev/null | wc -l || true)"
  echo "INFO shellcheck(vendored): $n warnings in ${#vendored[@]} vendored scripts (non-blocking)"
fi

gate bats         bats test/unit
gate branding     bin/oal-dev-branding-check
# --strict: every background must carry a source and licence on its NOTICE line.
# The placeholder UNAUDITED status existed for the 68 inherited wallpapers, which are gone; letting a
# new one in unaudited is how the repository ended up publishing images nobody could account for.
gate notice       bin/oal-dev-notice-check --strict
gate gitleaks     gitleaks detect --no-banner --redact --source . -c .gitleaks.toml
# The history scan only sees committed blobs; this one reads the files on disk, so a secret is
# caught before it is committed rather than after (a secret in git history is permanent). It stages
# the committable file set rather than walking the filesystem; walking it reads the multi-gigabyte
# VM images under .vm/ and .vm-cache/ into memory. The script header has the detail.
gate gitleaks-worktree bin/oal-dev-gitleaks-worktree
gate vendor-drift bin/oal-dev-sync-upstream --check
# Seven defects in one week were this shape: something handed to another system that could not
# resolve it. Handing over always succeeds -- the notification sends, the unit enables, the alias
# defines -- so only the consumer fails, later, quietly. This checks the handover points.
gate dangling     bin/oal-dev-dangling-check
exit $fail
