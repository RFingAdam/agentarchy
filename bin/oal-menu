#!/usr/bin/env bash
# oal:summary=The Agentarchy menu
# oal:args=[route]
# oal:examples=oal menu | oal-menu theme | oal-menu agent
#
# A tree, walked with oal-menu-select. Upstream's version was nine lines around a call to a
# Quickshell plugin this distribution does not ship, so it exited 127 on every invocation.
#
# Every entry here runs a command that exists on this tree. That is a deliberate constraint rather
# than a coincidence: an entry that silently does nothing is worse than an absent one, and the whole
# inherited menu was entries of exactly that kind. test/unit/menu.bats enforces it.
set -euo pipefail

bin_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
OAL_PATH="${OAL_PATH:-$(dirname "$bin_dir")}"
export OAL_PATH

pick() { oal-menu-select "$@"; }

# Run something the menu chose, and say so on screen when it fails.
#
# The menu is launched from a dock icon, so it has no terminal: anything written to stderr goes to
# the journal, where nobody is looking. Picking a theme that then failed to apply looked exactly
# like the menu doing nothing at all, which is the single most confusing way for it to break -- and
# `set -e` made it worse by taking the whole menu down without a word.
run() {
  local what="$1"; shift
  local out rc=0
  out="$("$@" 2>&1)" || rc=$?
  (( rc == 0 )) && return 0
  # Last line only: the notification is a hint to go and look, not a log viewer.
  oal-notification-send "$what failed" "$(printf '%s' "$out" | tail -n 1)" 2>/dev/null ||
    printf '%s\n' "$out" >&2
  return "$rc"
}

menu_theme() {
  local themes=() name d chosen
  for d in "$OAL_PATH"/themes/*/; do
    name="$(basename "$d")"
    themes+=("$(printf '\t%s' "$name")")
  done
  chosen="$(printf '%s\n' "${themes[@]}" | pick Theme)" || return 0
  run "Theme $chosen" oal-theme-set "$chosen"
}

menu_layout() {
  local chosen
  chosen="$(printf '%s\n' $'\tubuntu\ttop bar and a dock' $'\tmint\tone taskbar along the bottom' | pick Layout)" || return 0
  run "Layout ${chosen%%$'\t'*}" oal-layout-set "${chosen%%$'\t'*}"
}

menu_agent() {
  local chosen p
  chosen="$(printf '%s\n' \
    $'\task\tput a question to this machine' \
    $'\tposture\tread-only, confirmed, or permissive' \
    $'\tservers\twhich MCP servers are registered' \
    $'\tbrain\twhich backend answers, and whether it is reachable' | pick Agent)" || return 0
  case "${chosen%%$'\t'*}" in
    # oal-ask reports its own failures on screen, including having no backend, so this must not
    # report them a second time through run().
    ask) oal-ask || true ;;
    brain)
      local status
      status="$(oal-brain-status 2>&1)"
      # Silent and exit 0 is what "no backend" looks like, and an empty picker is not an answer.
      [[ -n $status ]] || status="no brain backend configured"
      printf '%s\n' "$status" | pick Brain >/dev/null || true
      ;;
    posture)
      p="$(printf '%s\n' \
        $'\tscoped\tthe default: writes are confirmed' \
        $'\tuntrusted\teverything is confirmed' \
        $'\ttrusted\tpermissive' | pick Posture)" || return 0
      run "Posture ${p%%$'\t'*}" oal-agent-profile "${p%%$'\t'*}"
      ;;
    servers) oal-mcp-status | pick MCP >/dev/null || true ;;
  esac
}

# The Hermes surface, and it only appears when Hermes is the backend. The contract's four verbs are
# backend-neutral on purpose; boards, gateways and workers are things one particular agent has, and
# putting them behind a neutral verb set would either bloat the contract or waste the machine.
menu_hermes() {
  local chosen board
  chosen="$(printf '%s\n' \
    $'\tstatus\tgateways running and what is waiting' \
    $'\tboards\tkanban boards on this Hermes' \
    $'\twaiting\ttasks that want a person' \
    $'\tgateways\tstart, stop or restart the gateway' | pick Hermes)" || return 0
  case "${chosen%%$'\t'*}" in
    status)  run "Hermes status" oal-hermes-status ;;
    boards)  oal-hermes kanban boards 2>/dev/null | pick Boards >/dev/null || true ;;
    waiting)
      # One board at a time: the picker is a list, not a report, and 49 rows from ten boards with no
      # board named against them would be worse than useless.
      board="$(oal-hermes kanban boards 2>/dev/null |
        awk '{for(i=1;i<=NF;i++) if ($i ~ /^[a-z0-9-]+$/) {print $i; exit}}' | pick Board)" || return 0
      menu_hermes_board "$board"
      ;;
    gateways) menu_hermes_gateways ;;
  esac
}

# The tasks on one board that still owe something, and what you can do about the one you pick. The
# id leads the row so the picker hands it straight back; the title is what you actually read.
menu_hermes_board() {
  local board="$1" rows chosen id
  rows="$(oal-hermes kanban list --board "$board" --json 2>/dev/null |
    jq -r '.[] | select(.status | test("review|blocked|ready|todo|triage|scheduled"))
           | "\t\(.id)\t\(.status): \(.title)"' 2>/dev/null)"
  [[ -n ${rows//[[:space:]]/} ]] || { oal-notification-send "$board" "nothing waiting" >/dev/null 2>&1; return 0; }
  chosen="$(printf '%s\n' "$rows" | pick "$board")" || return 0
  id="${chosen%%$'\t'*}"
  [[ -n $id ]] || return 0
  menu_hermes_task "$id"
}

menu_hermes_task() {
  local id="$1" act
  act="$(printf '%s\n' \
    $'\tclaim\ttake it, so nothing else picks it up' \
    $'\tpromote\tapprove it and move it forward' \
    $'\tcomplete\tmark it done' \
    $'\tshow\tread it first' | pick "$id")" || return 0
  case "${act%%$'\t'*}" in
    # oal-hermes-do asks again, naming the task. Two prompts is right for something that lands on a
    # board other people and other workers are reading.
    claim)    run "Claim $id"    oal-hermes-do claim "$id" ;;
    promote)  run "Promote $id"  oal-hermes-do promote "$id" ;;
    complete) run "Complete $id" oal-hermes-do complete "$id" ;;
    show)     oal-hermes kanban show "$id" 2>/dev/null | pick "$id" >/dev/null || true ;;
  esac
}

menu_hermes_gateways() {
  local chosen
  # Hermes starts and stops the profile it is currently on; `gateway start <name>` is not something
  # it takes, and switching profile sets a sticky default -- a lasting change, not a menu action.
  chosen="$(printf '%s\n' \
    $'\tlist\twhich gateways are running' \
    $'\tgateway-restart\trestart the current profile' \
    $'\tgateway-start\tstart the current profile' \
    $'\tgateway-stop\tstop the current profile' | pick Gateways)" || return 0
  case "${chosen%%$'\t'*}" in
    list) oal-hermes gateway list 2>/dev/null | pick Gateways >/dev/null || true ;;
    *)    run "Gateway" oal-hermes-do "${chosen%%$'\t'*}" ;;
  esac
}

menu_system() {
  local chosen
  chosen="$(printf '%s\n' \
    $'\tlock\tlock the session' \
    $'\tlogout\tend the session' \
    $'\treboot\trestart the machine' \
    $'\tshutdown\tpower off' | pick System)" || return 0
  case "${chosen%%$'\t'*}" in
    lock) loginctl lock-session ;;
    logout) qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout ;;
    reboot) qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndReboot ;;
    shutdown) qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndShutdown ;;
  esac
}

route="${1:-root}"
case "$route" in
  theme) menu_theme ;;
  layout) menu_layout ;;
  agent) menu_agent ;;
  system) menu_system ;;
  hermes) menu_hermes ;;
  -h | --help) sed -n '2,4p' "$0"; exit 0 ;;
  root)
    chosen="$(printf '%s\n' \
      $'\tTheme\tcolours, wallpaper, and everything themed' \
      $'\tLayout\tpanels and dock' \
      $'\tAgent\tposture and MCP servers' \
      $'\tHermes\tgateways, boards and what is waiting' \
      $'\tSystem\tlock, log out, restart' | pick Agentarchy)" || exit 0
    case "${chosen%%$'\t'*}" in
      Theme) menu_theme ;;
      Layout) menu_layout ;;
      Agent) menu_agent ;;
      Hermes) menu_hermes ;;
      System) menu_system ;;
    esac
    ;;
  *) echo "oal-menu: no route '$route' (try theme, layout, agent, system)" >&2; exit 1 ;;
esac
