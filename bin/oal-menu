#!/usr/bin/env bash
# oal:summary=The Agentarchy menu
# oal:args=[route]
# oal:examples=oal menu | oal-menu theme | oal-menu agent
#
# A tree, walked with oal-menu-select. Upstream's version was nine lines around a call to a
# Quickshell plugin this distribution does not ship, so it exited 127 on every invocation.
#
# Every entry here runs a command that exists on this tree. That is a deliberate constraint rather
# than a coincidence: an entry that silently does nothing is worse than an absent one, and the whole
# inherited menu was entries of exactly that kind. test/unit/menu.bats enforces it.
set -euo pipefail

bin_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
OAL_PATH="${OAL_PATH:-$(dirname "$bin_dir")}"
export OAL_PATH

pick() { oal-menu-select "$@"; }

# Run something the menu chose, and say so on screen when it fails.
#
# The menu is launched from a dock icon, so it has no terminal: anything written to stderr goes to
# the journal, where nobody is looking. Picking a theme that then failed to apply looked exactly
# like the menu doing nothing at all, which is the single most confusing way for it to break -- and
# `set -e` made it worse by taking the whole menu down without a word.
run() {
  local what="$1"; shift
  local out rc=0
  out="$("$@" 2>&1)" || rc=$?
  (( rc == 0 )) && return 0
  # Last line only: the notification is a hint to go and look, not a log viewer.
  oal-notification-send "$what failed" "$(printf '%s' "$out" | tail -n 1)" 2>/dev/null ||
    printf '%s\n' "$out" >&2
  return "$rc"
}

menu_theme() {
  local themes=() name d chosen
  for d in "$OAL_PATH"/themes/*/; do
    name="$(basename "$d")"
    themes+=("$(printf '\t%s' "$name")")
  done
  chosen="$(printf '%s\n' "${themes[@]}" | pick Theme)" || return 0
  run "Theme $chosen" oal-theme-set "$chosen"
}

menu_layout() {
  local chosen
  chosen="$(printf '%s\n' $'\tubuntu\ttop bar and a dock' $'\tmint\tone taskbar along the bottom' | pick Layout)" || return 0
  run "Layout ${chosen%%$'\t'*}" oal-layout-set "${chosen%%$'\t'*}"
}

menu_agent() {
  local chosen p
  chosen="$(printf '%s\n' \
    $'\task\tput a question to this machine' \
    $'\tposture\tread-only, confirmed, or permissive' \
    $'\tservers\twhich MCP servers are registered' \
    $'\tbrain\twhich backend answers, and whether it is reachable' | pick Agent)" || return 0
  case "${chosen%%$'\t'*}" in
    # oal-ask reports its own failures on screen, including having no backend, so this must not
    # report them a second time through run().
    ask) oal-ask || true ;;
    brain)
      local status
      status="$(oal-brain-status 2>&1)"
      # Silent and exit 0 is what "no backend" looks like, and an empty picker is not an answer.
      [[ -n $status ]] || status="no brain backend configured"
      printf '%s\n' "$status" | pick Brain >/dev/null || true
      ;;
    posture)
      p="$(printf '%s\n' \
        $'\tscoped\tthe default: writes are confirmed' \
        $'\tuntrusted\teverything is confirmed' \
        $'\ttrusted\tpermissive' | pick Posture)" || return 0
      run "Posture ${p%%$'\t'*}" oal-agent-profile "${p%%$'\t'*}"
      ;;
    servers) oal-mcp-status | pick MCP >/dev/null || true ;;
  esac
}

# The Hermes surface. Deliberately small: Hermes has its own dashboard, built for driving boards, and
# a menu tree that reimplements it badly is worse than a link to the real thing. Claiming, promoting
# and completing live there, where they belong.
menu_hermes() {
  local chosen
  chosen="$(printf '%s\n' \
    $'\tdashboard\topen Hermes\'s own dashboard' \
    $'\tstatus\tgateways running and what is waiting' \
    $'\twaiting\tthe tasks that want a person' | pick Hermes)" || return 0
  case "${chosen%%$'\t'*}" in
    dashboard) run "Hermes dashboard" oal-hermes-dashboard ;;
    status)    run "Hermes status" oal-hermes-status --cached ;;
    waiting)   oal-hermes-waiting --cached 2>/dev/null | pick Waiting >/dev/null || true ;;
  esac
}

menu_system() {
  local chosen
  chosen="$(printf '%s\n' \
    $'\tlock\tlock the session' \
    $'\tlogout\tend the session' \
    $'\treboot\trestart the machine' \
    $'\tshutdown\tpower off' | pick System)" || return 0
  case "${chosen%%$'\t'*}" in
    lock) loginctl lock-session ;;
    logout) qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout ;;
    reboot) qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndReboot ;;
    shutdown) qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndShutdown ;;
  esac
}

route="${1:-root}"
# What is wrong with this machine, one click from the dock.
#
# oal-doctor without a surface here would be the same mistake this whole menu was rewritten to fix:
# something present, correct, and on a path nobody looks at. Selecting a finding hands it to the
# configured agent, which is the same thing clicking its notification does.
menu_health() {
  local report rows=() chosen id
  report="$(oal-doctor --json 2>/dev/null)" || true
  if [[ -z $report ]]; then
    oal-notification-send "Health" "oal-doctor produced nothing" 2>/dev/null || true
    return 0
  fi

  # Findings first, then the rest, so the thing worth acting on is the thing under the cursor.
  while IFS=$'\t' read -r id severity summary; do
    [[ -n $id ]] || continue
    rows+=("$(printf '\t%s\t%s' "$summary" "$severity")")
  done < <(printf '%s' "$report" | jq -r '
    .checks
    | sort_by(if .severity == "problem" then 0 elif .severity == "warn" then 1
              elif .severity == "unknown" then 2 else 3 end)
    | .[] | [.id, .severity, .summary] | @tsv')

  chosen="$(printf '%s\n' "${rows[@]}" | pick Health)" || return 0
  [[ -n $chosen ]] || return 0

  # Back from the summary to the id, because the picker answers with what it displayed.
  id="$(printf '%s' "$report" | jq -r --arg s "${chosen%%$'\t'*}" '.checks[] | select(.summary == $s) | .id' | head -1)"
  [[ -n $id ]] || return 0
  run "Diagnose $id" oal-agent-diagnose "$id"
}

case "$route" in
  health) menu_health ;;
  theme) menu_theme ;;
  layout) menu_layout ;;
  agent) menu_agent ;;
  system) menu_system ;;
  hermes) menu_hermes ;;
  -h | --help) sed -n '2,4p' "$0"; exit 0 ;;
  root)
    chosen="$(printf '%s\n' \
      $'\tHealth\twhat is wrong with this machine, and ask about it' \
      $'\tTheme\tcolours, wallpaper, and everything themed' \
      $'\tLayout\tpanels and dock' \
      $'\tAgent\tposture and MCP servers' \
      $'\tHermes\tgateways, boards and what is waiting' \
      $'\tSystem\tlock, log out, restart' | pick Agentarchy)" || exit 0
    case "${chosen%%$'\t'*}" in
      Health) menu_health ;;
      Theme) menu_theme ;;
      Layout) menu_layout ;;
      Agent) menu_agent ;;
      Hermes) menu_hermes ;;
      System) menu_system ;;
    esac
    ;;
  *) echo "oal-menu: no route '$route' (try health, theme, layout, agent, hermes, system)" >&2; exit 1 ;;
esac
