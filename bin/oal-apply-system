#!/bin/bash

# oal:summary=Apply Agentarchy system setup in the installed target
# oal:group=apply
# oal:requires-sudo=true
# oal:examples=oal apply system --install-user dhh --first-install
# oal:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: oal apply system --install-user USER [--first-install|--upgrade]
       oal apply system --defer-provisioning --first-install

Runs root-owned Agentarchy system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
oal-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/oal/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${OAL_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: oal-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export OAL_INSTALL_USER="$install_user"
export OAL_FIRST_INSTALL="$first_install"
export OAL_UPGRADE="$upgrade"
export OAL_PATH="${OAL_PATH:-/usr/share/agentarchy}"
export OAL_INSTALL="${OAL_INSTALL:-$OAL_PATH/install}"
export OAL_INSTALL_LOG_FILE="${OAL_INSTALL_LOG_FILE:-/var/log/oal-install.log}"
export PATH="$OAL_PATH/bin:$PATH"

source "$OAL_INSTALL/helpers/logging.sh"
start_install_log

source "$OAL_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  oal-apply-hardware --defer-provisioning
else
  oal-apply-hardware --install-user "$install_user"
fi

source "$OAL_INSTALL/login/all.sh"
source "$OAL_INSTALL/post-install/all.sh"

stop_install_log
