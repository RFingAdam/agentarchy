#!/bin/bash

# oal:summary=Reinstall Agentarchy packages and reset default configs
# oal:requires-sudo=true

set -e

echo -e "This will reinstall all default Agentarchy packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  oal-reinstall-pkgs
  oal-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && oal-system-reboot
fi
