#!/bin/bash

# oal:summary=List available themes
# oal:examples=oal theme list | oal theme set "Tokyo Night"

{
  find ~/.config/oal/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$OAL_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
