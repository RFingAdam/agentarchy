#!/bin/bash

# oal:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# oal:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
oal-pkg-add heroic-games-launcher-bin
oal-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
