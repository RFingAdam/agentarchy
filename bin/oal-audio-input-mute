#!/bin/bash

# oal:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  oal-brightness-keyboard-mute on
  oal-osd -i microphone-muted -m "Microphone muted"
else
  oal-brightness-keyboard-mute off
  oal-osd -i microphone -m "Microphone on"
fi
