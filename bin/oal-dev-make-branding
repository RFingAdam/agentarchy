#!/usr/bin/env bash
# oal:summary=Draw the Agentarchy mark and wordmark, and put copies where the boot chain reads them
# oal:args=[--colour <#rrggbb>] [--out-dir <dir>]
#
# Repo tooling, not shipped: the output is committed.
#
# This script *is* the mark. The geometry lives here as coordinates rather than in an editor file,
# because default/branding/mark.svg and the four PNGs have to be the same shape, and the only way to
# guarantee that is to generate all of them from one list of numbers. Edit the numbers, rerun, commit.
#
# The mark is an A with a flat top. A pointed A is a mountain, which is Arch's and not ours to
# borrow; flattening the apex turns the same letter into an arch -- a span on two legs with a
# crossbar, which is the word the project is named after. No serif, gradient or shadow, so nothing
# is lost between a 16 px favicon and the boot splash.
#
# Note on SVG: ImageMagick's librsvg delegate shells out to rsvg-convert, which is not installed
# here, and its internal MSVG renderer silently draws nothing for a stroked path -- a blank 512 px
# PNG with one colour in it. So the PNGs are drawn with -draw primitives and the SVG is emitted
# alongside for the web and the README. Same coordinates, two outputs, neither one derived from the
# other by a rasteriser we do not have.
set -euo pipefail
export LC_ALL=C
# shellcheck source=bin/oal-dev-lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/oal-dev-lib.sh"
root="$(oal_dev_root)" || exit 1
cd "$root"

colour="#ffffff"   # the boot splash and greeter sit on dark; per-theme colour is applied by consumers
out_dir="default/branding"
while (($#)); do
  case "$1" in
    --colour) colour="${2:?--colour wants #rrggbb}"; shift 2 ;;
    --out-dir) out_dir="${2:?--out-dir wants a path}"; shift 2 ;;
    -h | --help) sed -n '2,3p' "$0"; exit 0 ;;
    *) oal_dev_die "unknown argument: $1" ;;
  esac
done
command -v magick >/dev/null || oal_dev_die "ImageMagick (magick) is required"
mkdir -p -- "$out_dir"

# --- the geometry, in a 100x100 box ---------------------------------------------------------------
# Legs and flat apex, then the crossbar. Stroke width is a share of the box so it scales with it.
LEGS=(20 86  37.5 19  62.5 19  80 86)
BAR=(28.5 62.5  71.5 62.5)
STROKE=7

scale_pts() { # scale_pts <size> <x y x y ...> -- prints "x,y x,y ..." at that box size
  local size="$1"; shift
  local pts=("$@") res=() i
  for ((i = 0; i < ${#pts[@]}; i += 2)); do
    res+=("$(awk -v a="${pts[i]}" -v b="${pts[i + 1]}" -v s="$size" \
      'BEGIN { printf "%.1f,%.1f", a * s / 100, b * s / 100 }')")
  done
  printf '%s' "${res[*]}"
}

draw_mark() { # draw_mark <size> <colour> <background> <out.png>
  local size="$1" col="$2" bg="$3" out="$4" sw
  sw="$(awk -v s="$size" -v w="$STROKE" 'BEGIN{printf "%.2f", w*s/100}')"
  magick -size "${size}x${size}" "xc:$bg" -fill none -stroke "$col" -strokewidth "$sw" \
    -draw "stroke-linecap round stroke-linejoin round polyline $(scale_pts "$size" "${LEGS[@]}")" \
    -draw "stroke-linecap round polyline $(scale_pts "$size" "${BAR[@]}")" \
    "$out"
}

# --- the mark -------------------------------------------------------------------------------------

draw_mark 512 "$colour" none "$out_dir/mark.png"

{
  printf '<!-- Generated by bin/oal-dev-make-branding. Edit the coordinates there, not here. -->\n'
  printf '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100"\n'
  printf '     role="img" aria-label="Agentarchy">\n'
  printf '  <path d="M%s %s L%s %s L%s %s L%s %s" fill="none" stroke="currentColor"\n' "${LEGS[@]}"
  printf '        stroke-width="%s" stroke-linecap="round" stroke-linejoin="round"/>\n' "$STROKE"
  printf '  <path d="M%s %s L%s %s" fill="none" stroke="currentColor"\n' "${BAR[@]}"
  printf '        stroke-width="%s" stroke-linecap="round"/>\n' "$STROKE"
  printf '</svg>\n'
} > "$out_dir/mark.svg"

# --- the lockup the boot chain reads --------------------------------------------------------------
# Stacked, not side by side. The word begins with the same letter the mark is, so setting them on
# one baseline reads as "A agentarchy" -- the mark stops being a mark and becomes a stutter.
# DejaVu Sans Bold because it is what oal-show-logo's half-block wordmark was traced from, so the
# terminal and the splash look related.

draw_mark 230 "$colour" none "$out_dir/.mark-tmp.png"
magick -background none -fill "$colour" -font DejaVu-Sans-Bold -pointsize 88 -kerning 6 \
  label:agentarchy "$out_dir/.word-tmp.png"
magick "$out_dir/.mark-tmp.png" \
  \( -size 1x26 xc:none \) \
  "$out_dir/.word-tmp.png" \
  -background none -gravity center -append \
  -bordercolor none -border 24 "$out_dir/logo.png"
rm -f -- "$out_dir/.mark-tmp.png" "$out_dir/.word-tmp.png"

# Byte-identical copies rather than symlinks: Plymouth's theme directory is copied into the
# initramfs, where a symlink pointing out of it would dangle.
cp -- "$out_dir/logo.png" default/plymouth/logo.png
magick -size 480x270 xc:'#151412' \( "$out_dir/logo.png" -resize 380x \) \
  -gravity center -composite default/plymouth/preview-unlock.png

for f in "$out_dir/mark.png" "$out_dir/mark.svg" "$out_dir/logo.png" \
         default/plymouth/logo.png default/plymouth/preview-unlock.png; do
  oal_dev_log "$f ($(stat -c %s -- "$f") bytes)"
done
