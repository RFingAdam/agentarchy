#!/usr/bin/env bash
# oal:summary=Pick one option from a menu
# oal:group=menu
# oal:name=select
# oal:args=prompt [option...] [-- menu args...]
# oal:examples=oal menu select Format jpg png|oal-menu-select Resolution 4k 1080p 720p -- --width 400
#
# An option may lead with an icon, as "<glyph><TAB><label>", and may trail a subtext shown under the
# label, as "<glyph><TAB><label><TAB><subtext>". The menu shows the glyph but never returns it. A
# plain option returns the label alone; an option with a subtext returns "<label><TAB><subtext>", so
# callers with same-named rows get the subtext back as the stable key.
#
# That contract is upstream's and is preserved exactly, because other commands already depend on it.
# What changed underneath is the backend: upstream summoned a Quickshell plugin over an IPC this
# distribution does not ship, so every call exited 127. fuzzel is a Wayland picker in dmenu mode,
# themed from the current palette by default/themed/fuzzel.ini.tpl.
set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: oal-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

prompt="$1"; shift

options=()
menu_width=""
menu_lines=""
while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    shift
    while (( $# > 0 )); do
      case "$1" in
        --width) shift; (( $# )) || { echo "oal-menu-select: --width requires a value" >&2; exit 1; }; menu_width="$1" ;;
        --height | --maxheight) shift; (( $# )) || { echo "oal-menu-select: needs a value" >&2; exit 1; }; menu_lines="$1" ;;
      esac
      shift
    done
    break
  fi
  options+=("$1")
  shift
done

# Options on stdin when none were given as arguments, so this composes in a pipeline.
if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi
(( ${#options[@]} )) || { echo "Usage: oal-menu-select <prompt> [option...] [-- menu args...]" >&2; exit 1; }

config="${XDG_STATE_HOME:-$HOME/.local/state}/oal/current/theme/fuzzel.ini"
args=(--dmenu --prompt "$prompt> ")
[[ -r $config ]] && args+=(--config "$config")
[[ -n $menu_width ]] && args+=(--width "$menu_width")

# Fit the list to what is in it. The generated config asks for twelve rows and this menu offers four,
# so most of the box was empty -- and a click in that empty region closes the picker with no
# selection, which is indistinguishable from the menu ignoring you.
if [[ -n $menu_lines ]]; then
  args+=(--lines "$menu_lines")
else
  args+=(--lines "${#options[@]}")
fi

# Do not vanish when keyboard focus moves. By default fuzzel exits the moment it loses focus, and on
# this desktop a single click was enough to take it: the menu disappeared without acting on
# anything, which is exactly what "I click and nothing happens" looks like from the outside.
args+=(--no-exit-on-keyboard-focus-loss)

# The display line and the value are different things, so they are built in step and matched back by
# index rather than by parsing the picker's answer. Splitting the returned string would break the
# moment a label contained the separator, and labels are arbitrary text from whatever called this.
display=()
value=()
# Split on tabs by hand. `IFS=$'\t' read -r a b c` looks like it does this and does not: tab is IFS
# *whitespace*, so a leading tab is skipped and runs of tabs collapse into one. Every row here starts
# with an empty glyph field, so every row shifted left -- the label landed in the glyph, the subtext
# landed in the label, and the value this returned was the subtext. oal-menu then compared that
# against "Theme", "Layout", "Agent", "System", matched nothing, and exited without a word.
#
# That is why the menu opened and did nothing, through two different pickers.
split_row() {
  local s="$1"
  glyph="${s%%$'\t'*}"
  if [[ $s == *$'\t'* ]]; then
    local rest="${s#*$'\t'}"
    label="${rest%%$'\t'*}"
    if [[ $rest == *$'\t'* ]]; then subtext="${rest#*$'\t'}"; else subtext=""; fi
  else
    label=""; subtext=""
  fi
}

for opt in "${options[@]}"; do
  split_row "$opt"
  a="$glyph" b="$label" c="$subtext"
  if [[ -n ${c:-} ]]; then
    # The em dash here is a rendered glyph in a picker, not prose, and it is the one in this tree.
    # ASCII "--" between a label and its subtext reads as a command-line flag.
    display+=("$a $b — $c"); value+=("$b"$'\t'"$c")
  elif [[ -n ${b:-} ]]; then
    display+=("$a $b"); value+=("$b")
  else
    display+=("$a"); value+=("$a")
  fi
done

# kdialog first, because a menu has to work with a mouse.
#
# fuzzel is the better looking picker and it is keyboard-excellent, but on this desktop clicking an
# entry does not select it -- reported twice from a real mouse, and its own changelog says left click
# should select. Whatever the cause, a menu whose four entries do nothing when clicked is not a menu,
# and a picker that is beautiful and inert loses to a plain one that works.
#
# kdialog also answers with the tag rather than the label, so the value is matched back by index with
# no string round-trip at all. Set OAL_MENU_BACKEND=fuzzel to get the old picker.
if [[ ${OAL_MENU_BACKEND:-} != fuzzel ]] && command -v kdialog >/dev/null; then
  # Wide enough for a label and its subtext. The default is narrow enough to clip the first entry
  # and put a horizontal scrollbar under a four-item menu, which looks like a mistake because it is.
  kargs=(--title "Agentarchy" --geometry "620x400" --menu "$prompt")
  for i in "${!display[@]}"; do
    kargs+=("$i" "${display[$i]}")
  done
  chosen="$(kdialog "${kargs[@]}" 2>/dev/null)" || exit 1
  [[ $chosen =~ ^[0-9]+$ ]] || exit 1
  [[ -n ${value[$chosen]+set} ]] || exit 1
  printf '%s\n' "${value[$chosen]}"
  exit 0
fi

command -v fuzzel >/dev/null || { echo "oal-menu-select: neither kdialog nor fuzzel is installed" >&2; exit 1; }

chosen="$(printf '%s\n' "${display[@]}" | fuzzel "${args[@]}" 2>/dev/null)" || exit 1
[[ -n $chosen ]] || exit 1

for i in "${!display[@]}"; do
  [[ ${display[$i]} == "$chosen" ]] && { printf '%s\n' "${value[$i]}"; exit 0; }
done
exit 1
