#!/bin/bash

# oal:summary=Select and set the system timezone
# oal:group=menu
# oal:name=timezone

set -e

timezone=$(timedatectl list-timezones | oal-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
# No sudo: this runs from the menu, which has no terminal for a password prompt. timedated asks
# through polkit, and Plasma's polkit agent puts that prompt on screen. Plasma's clock follows the
# system zone on its own, so there is no clock to refresh afterwards.
timedatectl set-timezone "$timezone"
oal-notification-send "Timezone is now set to $timezone"
