#!/bin/bash

# oal:summary=Select and set the system timezone
# oal:group=menu
# oal:name=timezone

set -e

timezone=$(timedatectl list-timezones | oal-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
oal-shell -q oal.clock refresh
oal-notification-send "Timezone is now set to $timezone"
