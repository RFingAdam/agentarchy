#!/bin/bash

# oal:summary=Update Agentarchy and system packages
# oal:args=[-y]
# oal:examples=oal update | oal update -y
# oal:requires-sudo=true

set -e

if [[ -z ${OAL_UPDATE_LOGGED:-} ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env OAL_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/oal-update.log"
fi

if ! oal-update-lock held; then
  exec oal-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://github.com/RFingAdam/agentarchy\033[0m"' ERR
trap 'oal-update-stay-awake stop' EXIT

oal-update-requires-free-space

# -y is a promise not to ask anything. Steps that would need an answer report
# and move on instead of waiting on a prompt nobody is here to give.
[[ ${1:-} != "-y" ]] || export OAL_UPDATE_UNATTENDED=1

if [[ ${1:-} == "-y" ]] || oal-update-confirm; then
  # Before the snapshot: the cache is on the snapshotted subvolume, so pruning
  # after it frees nothing until that snapshot ages out.
  oal-update-pkg-prune

  # 127 means Snapper is deliberately absent. Any other failure already said
  # what went wrong, and a missing snapshot is not worth blocking an update
  # over, but it must not pass for one either.
  oal-snapshot create || (($? == 127)) ||
    echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2

  oal-update-stay-awake start

  oal-update-dev
  oal-update-keyring

  # Migrations ship with the packages installed here and are written against
  # them, so everything below waits on this finishing. An upgrade that stopped
  # takes the update with it rather than migrating against what is still on disk.
  oal-update-system-pkgs
  oal-migrate
  oal-hook post-update
  oal-update-aur-pkgs
  oal-update-mise
  oal-update-orphan-pkgs

  oal-update-analyze-logs
  oal-update-status

  # Release update-owned inhibitors before offering a reboot. A confirmed
  # reboot can terminate this process before its EXIT trap gets a chance to
  # remove the persistent Stay Awake marker.
  oal-update-stay-awake stop
  trap - EXIT

  oal-update-restart
fi
