#!/usr/bin/env bash
# Claude Code's PreToolUse hook, and nothing more than that.
#
# This file is an adapter. It speaks one runtime's contract -- read a hook payload on stdin, answer
# with a permissionDecision on stdout -- and hands the actual question to default/guard/lib.sh, which
# knows nothing about any vendor.
#
# The split exists because the guard was the distribution's strongest claim and the least portable
# thing in it: the decision logic, the rules and the audit log all lived inside a file shaped like
# Claude Code's hook API, so running Codex or a local Hermes meant nothing was gated at all. The
# policy was never Claude-specific. Only this file is.
#
# Wired by install/agent/runtime.sh. See docs/agent-guard.md.
#
# FAIL CLOSED, here as well as in the engine. A payload this cannot parse is a call this cannot
# classify, and an unclassified call is refused.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export OAL_PATH="${OAL_PATH:-$(dirname "$(dirname "$here")")}"
# shellcheck source=default/guard/lib.sh
source "$OAL_PATH/default/guard/lib.sh" 2>/dev/null || {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' \
    "the guard engine could not be loaded, so this call cannot be classified"
  exit 0
}

# Reasons are written by this tree, never taken from input, so the vocabulary stays fixed and no
# caller can inject punctuation into the JSON below.
answer() { # answer <decision> <reason>
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"%s"}}\n' \
    "$1" "$2"
  exit 0
}

refuse() { # refuse <reason> -- for the failures the engine never sees
  guard_log claude-code deny fail-closed unknown "$1"
  answer deny "$1"
}

command -v jq >/dev/null || refuse "jq is not installed, so this call cannot be classified"

# One jq, not two. This runs before every tool call the agent makes and each fork is paid every
# time: the first version spawned jq twice and then xargs, sed and grep once per rule, which came to
# fifty-odd processes and 334ms a call.
payload="$(cat)"
parsed="$(jq -r '[(.tool_name // ""), ([.tool_input // {} | .. | strings] | join(" "))] | @tsv' <<<"$payload" 2>/dev/null)"
[[ -n $parsed ]] || refuse "payload could not be parsed"
IFS=$'\t' read -r tool input <<<"$parsed"
[[ -n $tool ]] || refuse "payload has no tool_name"

# The engine logs the decision itself, including the matched pattern, which deliberately never
# reaches the reason handed back here.
verdict="$(guard_decide claude-code "$tool" "$input")"
IFS=$'\t' read -r decision _tier reason <<<"$verdict"
[[ -n $decision ]] || refuse "the guard engine returned nothing"

answer "$decision" "$reason"
