# working notes, not part of the distribution: per-phase implementation plans, the design spec,
# the task ledger and the corrections log. They are written for whoever is building this, not for
# whoever is installing it, and they carry owner-actions addressed to a person by name.
tasks/
docs/superpowers/

# build / sync scratch
.sync/
.superpowers/
release/
*.pkg.tar.zst
*.iso

# local state
.env
.env.*
*.age
!docs/examples/**/*.age.example
.claude/settings.local.json
# Claude Code session scratch: worktrees it creates for isolated work. They are full checkouts, so
# leaving one behind fails the branding gate (which scans the filesystem, not the index) and doubles
# every secret scan.
.claude/worktrees/

# editors
.idea/
.vscode/
*.swp

# local VM test scratch (never committed)
.vm/
.vm-cache/

# makepkg build output
pkg/
src/
